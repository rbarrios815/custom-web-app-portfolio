       font-size: .9rem;\n      }\n\n      .hero-copy { max-width: calc(100% - 74px); }\n\n      .hero-scene {\n        display: block;\n        position: absolute;\n        right: 7px;\n        bottom: 8px;\n        width: 78px;\n        min-height: 92px;\n        opacity: .92;\n      }\n\n      .hero-moon {\n        right: 2px;\n        top: 0;\n        width: 43px;\n        font-size: 1.25rem;\n      }\n\n      .hero-tree { left: -5px; font-size: 4rem; }\n      .hero-gifts { right: -3px; font-size: 1.8rem; }\n      .hero-sparkles { display: none; }\n\n      .card { border-width: 3px; }\n      .card-header::after { right: 4px; }\n      .christmas-footer { margin-top: 8px; padding-bottom: 0; font-size: .78rem; }\n\n      body {\n        padding: 12px 12px calc(92px + var(--safe-bottom));\n      }\n\n      .light-string { margin-bottom: 4px; }\n\n      .hero {\n        min-height: 0;\n        grid-template-columns: 1fr;\n        padding: 18px;\n        border-radius: 22px;\n      }\n\n      .wreath { display: none; }\n      .hero-copy { font-size: .92rem; }\n      .meta-bar { gap: 6px; }\n      .meta-chip { min-height: 30px; padding: 5px 9px; font-size: .8rem; }\n\n      .layout {\n        grid-template-columns: 1fr;\n        margin-top: 12px;\n      }\n\n      .side-column { display: none; }\n\n      .card { border-radius: 22px; }\n      .card-inner { padding: 18px; }\n      .card-header { margin-bottom: 13px; }\n\n      .name-row {\n        grid-template-columns: 1fr;\n      }\n\n      .name-row .button {\n        width: 100%;\n      }\n\n      .quick-actions {\n        grid-template-columns: repeat(3, minmax(0, 1fr));\n      }\n\n      .action-tile {\n        min-height: 76px;\n        padding: 9px 6px;\n        font-size: .82rem;\n      }\n\n      .action-tile small { display: none; }\n\n      .mobile-nav {\n        position: fixed;\n        left: 10px;\n        right: 10px;\n        bottom: calc(8px + var(--safe-bottom));\n        z-index: 80;\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        padding: 7px;\n        border: 1px solid rgba(255,255,255,.2);\n        border-radius: 20px;\n        background: rgba(8, 38, 29, .94);\n        box-shadow: 0 16px 44px rgba(0,0,0,.34);\n        backdrop-filter: blur(14px);\n      }\n\n      .nav-button {\n        display: grid;\n        justify-items: center;\n        gap: 2px;\n        min-height: 52px;\n        padding: 5px 2px;\n        color: white;\n        border: 0;\n        border-radius: 14px;\n        background: transparent;\n        font-size: .72rem;\n        font-weight: 760;\n        cursor: pointer;\n      }\n\n      .nav-button span:first-child { font-size: 1.2rem; }\n\n      .nav-button.active {\n        background: rgba(255,255,255,.12);\n      }\n\n      dialog {\n        width: 100vw;\n        max-width: none;\n        max-height: 92dvh;\n        margin: auto 0 0;\n        border-radius: 24px 24px 0 0;\n      }\n\n      .dialog-shell { max-height: 92dvh; }\n      .dialog-body { padding: 16px; }\n      .dialog-footer { justify-content: stretch; }\n      .dialog-footer .button { flex: 1; }\n      .list-grid { grid-template-columns: 1fr; }\n    }\n\n    @media (max-width: 420px) {\n      .hero h1 { font-size: 1.88rem; }\n      .quick-actions { gap: 7px; }\n      .action-tile { font-size: .76rem; }\n      .card-inner { padding: 16px; }\n      .radio-grid { grid-template-columns: 1fr; }\n    }\n\n    @media (prefers-reduced-motion: reduce) {\n      *, *::before, *::after {\n        scroll-behavior: auto !important;\n        animation-duration: .01ms !important;\n        animation-iteration-count: 1 !important;\n        transition-duration: .01ms !important;\n      }\n    }\n  </style>\n<style>select.demo-select{display:block;width:100%;min-height:48px;padding:12px;border:1px solid #b7c6bf;border-radius:12px;background:#fff;color:#183b37;font:inherit}select.demo-select:focus-visible{outline:3px solid #986119;outline-offset:3px}</style></head>\n<body onload=\"init()\"><div style=\"padding:10px 18px;background:#fff3ce;color:#49330c;font:600 14px/1.5 system-ui;text-align:center\" role=\"note\">Interactive portfolio demo · Fictional sample data only. Choose from fictional dropdown options. No personal information can be entered.</div>\n  <div class=\"north-pole-banner\" aria-hidden=\"true\">✦ Special delivery from the North Pole ✦</div>\n  <div class=\"loading-overlay\" id=\"loadingOverlay\" aria-live=\"polite\">\n    <div class=\"loading-box\">\n      <div class=\"spinner\" aria-hidden=\"true\"></div>\n      <strong>Checking Santa’s list…</strong>\n      <span>Loading the latest guests and dishes.</span>\n    </div>\n  </div>\n\n  <div class=\"app-shell\">\n    <div class=\"light-string\" aria-hidden=\"true\">\n      <span class=\"bulb\"></span><span class=\"bulb\"></span><span class=\"bulb\"></span><span class=\"bulb\"></span>\n      <span class=\"bulb\"></span><span class=\"bulb\"></span><span class=\"bulb\"></span><span class=\"bulb\"></span>\n    </div>\n\n    <header class=\"hero\">\n      <div class=\"hero-ornaments\" aria-hidden=\"true\"><span class=\"hero-ornament\"></span><span class=\"hero-ornament\"></span><span class=\"hero-ornament\"></span></div>\n      <div class=\"hero-copy-wrap\">\n        <p class=\"eyebrow\">🎄 The Snow Family Christmas 🎄</p>\n        <h1><span class=\"merry-title\">Merry Christmas!</span><span class=\"nice-list-title\">Santa’s Nice List</span></h1>\n        <p class=\"hero-copy\">Join the family celebration, add your guests, and choose a holiday dish—all wrapped up in one quick RSVP.</p>\n        <div class=\"meta-bar\" id=\"metaBar\" aria-label=\"Event details\"></div>\n      </div>\n      <div class=\"hero-scene\" aria-hidden=\"true\">\n        <div class=\"hero-moon\">🎅</div>\n        <div class=\"hero-tree\">🎄</div>\n        <div class=\"hero-gifts\">🎁</div>\n        <div class=\"hero-sparkles\">✨</div>\n      </div>\n    </header>\n\n    <main class=\"layout\">\n      <section class=\"stack\" aria-label=\"Christmas RSVP\">\n        <article class=\"card\">\n          <div class=\"card-inner\">\n            <div class=\"card-header\">\n              <div>\n                <p class=\"section-kicker\">Start here</p>\n                <h2>Are you coming?</h2>\n                <p class=\"helper\">Choose a fictional name. Dishes are optional, and sample guests come next.</p>\n              </div>\n              <div class=\"step-badge\" aria-hidden=\"true\">1</div>\n            </div>\n\n            <div class=\"name-row\">\n              <div class=\"field\" style=\"margin-top:0\">\n                <label for=\"inviterInput\">Fictional name <span class=\"required\">(required)</span></label>\n                <select class=\"demo-select\" id=\"inviterInput\" name=\"inviterInput\" aria-label=\"Fictional party name\"><option value=\"Alex Example\">Alex Example</option><option value=\"Morgan Sample\">Morgan Sample</option><option value=\"Taylor Demo\">Taylor Demo</option><option value=\"Casey Placeholder\">Casey Placeholder</option><option value=\"Holly Snow\">Holly Snow</option><option value=\"Noel Snow\">Noel Snow</option><option value=\"Nick Frost\">Nick Frost</option><option value=\"Jolly Evergreen\">Jolly Evergreen</option><option value=\"Holly Maple\">Holly Maple</option><option value=\"Oliver Acorn\">Oliver Acorn</option><option value=\"Autumn Fields\">Autumn Fields</option></select>\n                <div class=\"helper\" id=\"nameHelp\">Returning? Use the same name to view or update your party.</div>\n              </div>\n              <button class=\"button button-primary\" id=\"rsvpButton\" type=\"button\" onclick=\"saveRsvp()\">⭐ Save my RSVP</button>\n            </div>\n\n            <div class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></div>\n\n            <div class=\"success-panel\" id=\"successPanel\">\n              <div class=\"success-heading\"><span aria-hidden=\"true\">🎄</span><span id=\"successHeading\">You’re on the Nice List!</span></div>\n              <div class=\"my-party\" id=\"myPartyPreview\"></div>\n\n              <div class=\"quick-actions\">\n                <button class=\"action-tile\" type=\"button\" onclick=\"openGuestDialog()\">\n                  <span aria-hidden=\"true\">➕</span>\n                  <span>Add guest</span>\n                  <small>Name + age</small>\n                </button>\n                <button class=\"action-tile\" type=\"button\" onclick=\"openDishDialog()\">\n                  <span aria-hidden=\"true\">🍽️</span>\n                  <span>Choose dishes</span>\n                  <small>Optional</small>\n                </button>\n                <button class=\"action-tile\" type=\"button\" onclick=\"openNiceListDialog()\">\n                  <span aria-hidden=\"true\">🌲</span>\n                  <span>Guest list</span>\n                  <small>See everyone</small>\n                </button>\n              </div>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"card\" id=\"mobileSummaryCard\">\n          <div class=\"card-inner\">\n            <div class=\"card-header\">\n              <div>\n                <p class=\"section-kicker\">At a glance</p>\n                <h2>Christmas is coming</h2>\n                <p class=\"helper\" id=\"mobileSummaryText\">Loading the party snapshot…</p>\n              </div>\n              <div class=\"count-orb\" id=\"mobileCountOrb\">0</div>\n            </div>\n            <div class=\"quick-actions\">\n              <button class=\"action-tile\" type=\"button\" onclick=\"openNiceListDialog()\">\n                <span aria-hidden=\"true\">👥</span><span>Nice List</span><small>Guests</small>\n              </button>\n              <button class=\"action-tile\" type=\"button\" onclick=\"openFoodDialog()\">\n                <span aria-hidden=\"true\">🥧</span><span>Dishes</span><small>Open spots</small>\n              </button>\n              <button class=\"action-tile\" type=\"button\" onclick=\"openDetailsDialog()\">\n                <span aria-hidden=\"true\">🎅</span><span>Details</span><small>Gifts + help</small>\n              </button>\n            </div>\n          </div>\n        </article>\n      </section>\n\n      <aside class=\"stack side-column\" aria-label=\"Party dashboard\">\n        <article class=\"card side-card\">\n          <div class=\"card-inner\">\n            <div class=\"card-header\">\n              <div>\n                <p class=\"section-kicker\">Who’s coming</p>\n                <h2>Nice List</h2>\n              </div>\n              <div class=\"count-orb\" id=\"guestCount\">0</div>\n            </div>\n            <div class=\"preview-list\" id=\"niceListPreview\"></div>\n            <div class=\"side-actions\">\n              <button class=\"button button-secondary\" type=\"button\" onclick=\"openNiceListDialog()\">View everyone</button>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"card side-card\">\n          <div class=\"card-inner\">\n            <div class=\"card-header\">\n              <div>\n                <p class=\"section-kicker\">Potluck</p>\n                <h2>Holiday dishes</h2>\n              </div>\n              <div class=\"count-orb\" id=\"openDishCount\">0</div>\n            </div>\n            <div class=\"preview-list\" id=\"foodPreview\"></div>\n            <div class=\"side-actions\">\n              <button class=\"button button-secondary\" type=\"button\" onclick=\"openFoodDialog()\">View dish lineup</button>\n              <button class=\"button button-ghost\" type=\"button\" onclick=\"openDishDialog()\">Claim dishes</button>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"card side-card\">\n          <div class=\"card-inner\">\n            <div class=\"card-header\">\n              <div>\n                <p class=\"section-kicker\">Good to know</p>\n                <h2>Party details</h2>\n              </div>\n              <span aria-hidden=\"true\" style=\"font-size:2rem\">🎁</span>\n            </div>\n            <p class=\"helper\">Gift guidance, White Elephant rules, games, and contact information.</p>\n            <div class=\"side-actions\">\n              <button class=\"button button-ghost\" type=\"button\" onclick=\"openDetailsDialog()\">Open details</button>\n            </div>\n          </div>\n        </article>\n      </aside>\n    </main>\n    <footer class=\"christmas-footer\">❄️ Made with <strong>family, food, gifts, and Christmas cheer</strong> ❄️</footer>\n  </div>\n\n  <nav class=\"mobile-nav\" aria-label=\"Quick navigation\">\n    <button class=\"nav-button active\" type=\"button\" onclick=\"scrollToRsvp()\"><span aria-hidden=\"true\">⭐</span><span>RSVP</span></button>\n    <button class=\"nav-button\" type=\"button\" onclick=\"openNiceListDialog()\"><span aria-hidden=\"true\">👥</span><span>Guests</span></button>\n    <button class=\"nav-button\" type=\"button\" onclick=\"openFoodDialog()\"><span aria-hidden=\"true\">🍽️</span><span>Dishes</span></button>\n    <button class=\"nav-button\" type=\"button\" onclick=\"openDetailsDialog()\"><span aria-hidden=\"true\">🎅</span><span>Details</span></button>\n  </nav>\n\n  <dialog id=\"guestDialog\" aria-labelledby=\"guestDialogTitle\">\n    <form class=\"dialog-shell\" method=\"dialog\" onsubmit=\"event.preventDefault(); saveGuest();\">\n      <div class=\"dialog-header\">\n        <div>\n          <p class=\"section-kicker\" style=\"color:var(--gold-300)\">Add to your party</p>\n          <h2 id=\"guestDialogTitle\">Add a guest</h2>\n        </div>\n        <button class=\"icon-button\" type=\"button\" onclick=\"closeDialog('guestDialog')\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"dialog-body\">\n        <p class=\"helper\" id=\"guestOwnerText\">Save your own RSVP first.</p>\n        <div class=\"field\">\n          <label for=\"guestNameInput\">Fictional guest name <span class=\"required\">(required)</span></label>\n          <select class=\"demo-select\" id=\"guestNameInput\" name=\"guestNameInput\" aria-label=\"Fictional guest name\"><option value=\"Alex Example\">Alex Example</option><option value=\"Morgan Sample\">Morgan Sample</option><option value=\"Taylor Demo\">Taylor Demo</option><option value=\"Casey Placeholder\">Casey Placeholder</option><option value=\"Holly Snow\">Holly Snow</option><option value=\"Noel Snow\">Noel Snow</option><option value=\"Nick Frost\">Nick Frost</option><option value=\"Jolly Evergreen\">Jolly Evergreen</option><option value=\"Holly Maple\">Holly Maple</option><option value=\"Oliver Acorn\">Oliver Acorn</option><option value=\"Autumn Fields\">Autumn Fields</option></select>\n        </div>\n        <fieldset>\n          <legend>Age group <span class=\"required\">(required)</span></legend>\n          <div class=\"radio-grid\">\n            <label class=\"choice-card\">\n              <input type=\"radio\" name=\"guestAge\" value=\"11+\">\n              <span><span class=\"choice-title\">11 or older</span><span class=\"choice-help\">Teen or adult</span></span>\n            </label>\n            <label class=\"choice-card\">\n              <input type=\"radio\" name=\"guestAge\" value=\"10-\">\n              <span><span class=\"choice-title\">10 or younger</span><span class=\"choice-help\">Child gift group</span></span>\n            </label>\n          </div>\n        </fieldset>\n        <div class=\"status\" id=\"guestStatus\" role=\"status\" aria-live=\"polite\"></div>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"button button-ghost\" type=\"button\" onclick=\"closeDialog('guestDialog')\">Cancel</button>\n        <button class=\"button button-primary\" id=\"saveGuestButton\" type=\"submit\">Add guest</button>\n      </div>\n    </form>\n  </dialog>\n\n  <dialog id=\"dishDialog\" aria-labelledby=\"dishDialogTitle\">\n    <form class=\"dialog-shell\" method=\"dialog\" onsubmit=\"event.preventDefault(); saveDishes();\">\n      <div class=\"dialog-header\">\n        <div>\n          <p class=\"section-kicker\" style=\"color:var(--gold-300)\">Optional potluck</p>\n          <h2 id=\"dishDialogTitle\">Choose dishes</h2>\n        </div>\n        <button class=\"icon-button\" type=\"button\" onclick=\"closeDialog('dishDialog')\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"dialog-body\">\n        <p class=\"helper\">Check one or more available dishes. Choices already claimed by someone else are disabled.</p>\n        <div class=\"choice-grid\" id=\"dishChoices\"></div>\n        <div class=\"status\" id=\"dishStatus\" role=\"status\" aria-live=\"polite\"></div>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"button button-ghost\" type=\"button\" onclick=\"closeDialog('dishDialog')\">Cancel</button>\n        <button class=\"button button-primary\" id=\"saveDishButton\" type=\"submit\">Save dishes</button>\n      </div>\n    </form>\n  </dialog>\n\n  <dialog id=\"niceListDialog\" aria-labelledby=\"niceListDialogTitle\">\n    <div class=\"dialog-shell\">\n      <div class=\"dialog-header\">\n        <div>\n          <p class=\"section-kicker\" style=\"color:var(--gold-300)\">Party roster</p>\n          <h2 id=\"niceListDialogTitle\">Santa’s Nice List</h2>\n        </div>\n        <button class=\"icon-button\" type=\"button\" onclick=\"closeDialog('niceListDialog')\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"dialog-body\">\n        <div class=\"list-grid\" id=\"niceListFull\"></div>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"button button-secondary\" type=\"button\" onclick=\"closeDialog('niceListDialog')\">Done</button>\n      </div>\n    </div>\n  </dialog>\n\n  <dialog id=\"foodDialog\" aria-labelledby=\"foodDialogTitle\">\n    <div class=\"dialog-shell\">\n      <div class=\"dialog-header\">\n        <div>\n          <p class=\"section-kicker\" style=\"color:var(--gold-300)\">Potluck board</p>\n          <h2 id=\"foodDialogTitle\">Holiday dish lineup</h2>\n        </div>\n        <button class=\"icon-button\" type=\"button\" onclick=\"closeDialog('foodDialog')\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"dialog-body\">\n        <div class=\"detail-list\" id=\"foodListFull\"></div>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"button button-secondary\" type=\"button\" onclick=\"closeDialog('foodDialog')\">Done</button>\n      </div>\n    </div>\n  </dialog>\n\n  <dialog id=\"detailsDialog\" aria-labelledby=\"detailsDialogTitle\">\n    <div class=\"dialog-shell\">\n      <div class=\"dialog-header\">\n        <div>\n          <p class=\"section-kicker\" style=\"color:var(--gold-300)\">Before the party</p>\n          <h2 id=\"detailsDialogTitle\">Christmas details</h2>\n        </div>\n        <button class=\"icon-button\" type=\"button\" onclick=\"closeDialog('detailsDialog')\" aria-label=\"Close\">×</button>\n      </div>\n      <div class=\"dialog-body\">\n        <div class=\"detail-list\" id=\"detailsList\"></div>\n      </div>\n      <div class=\"dialog-footer\">\n        <button class=\"button button-secondary\" type=\"button\" onclick=\"closeDialog('detailsDialog')\">Done</button>\n      </div>\n    </div>\n  </dialog>\n\n  <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>\n\n  <script>\n    // This demo runs only through its own Apps Script backend.\n\n    const state = {\n      meta: {},\n      attendees: [],\n      menu: [],\n      currentOwner: null,\n      saving: false\n    };\n\n    const $ = (id) => document.getElementById(id);\n    const normalize = (value) => String(value || '').trim().replace(/\\s+/g, ' ').toLowerCase();\n    const cleanName = (value) => String(value || '').trim().replace(/\\s+/g, ' ');\n    const parseFoods = (value) => {\n      if (Array.isArray(value)) return value.map(String).map(v => v.trim()).filter(Boolean);\n      return String(value || '').split(/[;,\\n]/).map(v => v.trim()).filter(Boolean);\n    };\n\n    function toShortName(fullName) {\n      const parts = cleanName(fullName).split(' ').filter(Boolean);\n      if (parts.length < 2) return parts[0] || '';\n      return parts[0] + ' ' + parts[parts.length - 1].charAt(0).toUpperCase() + '.';\n    }\n\n    function isOwner(attendee) {\n      return attendee && normalize(attendee.fullName) === normalize(attendee.enteredBy || attendee.fullName);\n    }\n\n    function uniqueAttendees(list) {\n      const seen = new Set();\n      return (list || []).filter((item) => {\n        const key = item && item.row != null\n          ? 'row:' + item.row\n          : normalize(item.fullName) + '|' + normalize(item.enteredBy);\n        if (!key || seen.has(key)) return false;\n        seen.add(key);\n        return true;\n      });\n    }\n\n    function groupAttendees() {\n      const groups = new Map();\n      uniqueAttendees(state.attendees).forEach((attendee) => {\n        const label = cleanName(attendee.enteredBy || attendee.fullName || 'Host');\n        const key = normalize(label);\n        if (!groups.has(key)) groups.set(key, { inviter: label, people: [] });\n        groups.get(key).people.push(attendee);\n      });\n      return Array.from(groups.values()).sort((a, b) => a.inviter.localeCompare(b.inviter));\n    }\n\n    function findOwnerByName(name) {\n      const key = normalize(name);\n      return state.attendees.find((attendee) => isOwner(attendee) && normalize(attendee.fullName) === key) || null;\n    }\n\n    function getOwnerParty(owner) {\n      if (!owner) return [];\n      const ownerName = normalize(owner.fullName);\n      return uniqueAttendees(state.attendees)\n        .filter((attendee) => normalize(attendee.enteredBy || attendee.fullName) === ownerName)\n        .sort((a, b) => {\n          if (isOwner(a) && !isOwner(b)) return -1;\n          if (!isOwner(a) && isOwner(b)) return 1;\n          return cleanName(a.fullName).localeCompare(cleanName(b.fullName));\n        });\n    }\n\n    function claimedDishMap() {\n      const claims = new Map();\n      state.attendees.filter(isOwner).forEach((owner) => {\n        parseFoods(owner.food).forEach((dish) => {\n          const key = normalize(dish);\n          if (!key) return;\n          if (!claims.has(key)) claims.set(key, []);\n          claims.get(key).push(owner);\n        });\n      });\n      return claims;\n    }\n\n    function callBackend(action, payload) {\n      if (window.google && google.script && google.script.run) {\n        return new Promise((resolve, reject) => {\n          let runner = google.script.run\n            .withSuccessHandler(resolve)\n            .withFailureHandler((error) => reject(new Error(error && error.message ? error.message : String(error))));\n          runner[action](payload);\n        });\n      }\n\n      return Promise.reject(new Error('Open this demo in its Google Apps Script web app.'));\n    }\n\n    async function init() {\n      bindEvents();\n      try {\n        const data = await callBackend('getChristmasData');\n        applyData(data);\n        const remembered = cleanName(sessionStorage.getItem('christmas2025Name'));\n        if (remembered) {\n          $('inviterInput').value = remembered;\n          hydrateOwner(remembered, false);\n        }\n        setStatus('', 'success');\n      } catch (error) {\n        setStatus('Could not load the signup sheet. Please refresh or try again shortly. ' + error.message, 'error');\n      } finally {\n        $('loadingOverlay').classList.add('hidden');\n      }\n    }\n\n    function bindEvents() {\n      $('inviterInput').addEventListener('input', () => {\n        $('inviterInput').removeAttribute('aria-invalid');\n        const exact = findOwnerByName($('inviterInput').value);\n        if (exact) {\n          hydrateOwner(exact.fullName, false);\n          setStatus('Welcome back, ' + toShortName(exact.fullName) + '. Your party is ready to update.', 'success');\n        } else if (state.currentOwner && normalize(state.currentOwner.fullName) !== normalize($('inviterInput').value)) {\n          state.currentOwner = null;\n          renderMyParty();\n        }\n      });\n\n      document.querySelectorAll('dialog').forEach((dialog) => {\n        dialog.addEventListener('click', (event) => {\n          if (event.target === dialog) dialog.close();\n        });\n      });\n    }\n\n    function applyData(data) {\n      state.meta = data && data.meta ? data.meta : {};\n      state.attendees = uniqueAttendees(data && data.attendees ? data.attendees : []);\n      state.menu = Array.from(new Set((data && data.menu ? data.menu : []).map(cleanName).filter(Boolean)));\n      renderAll();\n    }\n\n    function renderAll() {\n      renderMeta();\n      renderNiceList();\n      renderFood();\n      renderDetails();\n      renderMyParty();\n      renderSummary();\n    }\n\n    function renderMeta() {\n      const meta = state.meta || {};\n      const chips = [\n        ['📅', meta.date || '12/24'],\n        meta.time ? ['🕰️', meta.time] : null,\n        meta.address ? ['📍', meta.address] : null,\n        ['👥', uniqueAttendees(state.attendees).length + ' signed up']\n      ].filter(Boolean);\n\n      $('metaBar').innerHTML = '';\n      chips.forEach(([icon, text]) => {\n        const chip = document.createElement('span');\n        chip.className = 'meta-chip';\n        chip.textContent = icon + ' ' + text;\n        $('metaBar').appendChild(chip);\n      });\n    }\n\n    function renderSummary() {\n      const total = uniqueAttendees(state.attendees).length;\n      const claims = claimedDishMap();\n      const open = state.menu.filter((item) => !claims.has(normalize(item))).length;\n      $('guestCount').textContent = String(total);\n      $('mobileCountOrb').textContent = String(total);\n      $('openDishCount').textContent = String(open);\n      $('mobileSummaryText').textContent = total\n        ? total + ' guest' + (total === 1 ? '' : 's') + ' signed up • ' + open + ' dish' + (open === 1 ? '' : 'es') + ' still open'\n        : 'Be the first person to join Santa’s Nice List.';\n    }\n\n    function renderNiceList() {\n      const groups = groupAttendees();\n      const preview = $('niceListPreview');\n      const full = $('niceListFull');\n      preview.innerHTML = '';\n      full.innerHTML = '';\n\n      if (!groups.length) {\n        preview.innerHTML = '<div class=\"empty-state\">No RSVPs yet. Be the first star on the tree.</div>';\n        full.innerHTML = '<div class=\"empty-state\">No RSVPs yet.</div>';\n        return;\n      }\n\n      groups.slice(0, 3).forEach((group) => {\n        const row = document.createElement('div');\n        row.className = 'preview-row';\n        row.innerHTML =\n          '<div class=\"preview-main\"><span aria-hidden=\"true\">⭐</span><span>' + escapeHtml(toShortName(group.inviter)) + '</span></div>' +\n          '<div class=\"preview-meta\">' + group.people.length + ' in party</div>';\n        preview.appendChild(row);\n      });\n\n      if (groups.length > 3) {\n        const more = document.createElement('div');\n        more.className = 'helper';\n        more.textContent = '+' + (groups.length - 3) + ' more family group' + (groups.length - 3 === 1 ? '' : 's');\n        preview.appendChild(more);\n      }\n\n      groups.forEach((group) => {\n        const card = document.createElement('section');\n        card.className = 'group-card';\n\n        const people = group.people.slice().sort((a, b) => {\n          if (isOwner(a) && !isOwner(b)) return -1;\n          if (!isOwner(a) && isOwner(b)) return 1;\n          return cleanName(a.fullName).localeCompare(cleanName(b.fullName));\n        });\n\n        const title = document.createElement('div');\n        title.className = 'group-title';\n        title.innerHTML = '<span>⭐ ' + escapeHtml(toShortName(group.inviter)) + '</span><span>' + people.length + '</span>';\n        card.appendChild(title);\n\n        const members = document.createElement('div');\n        members.className = 'group-members';\n        people.forEach((person) => {\n          const member = document.createElement('div');\n          member.className = 'group-member';\n          const age = isOwner(person) ? 'Host' : (person.ageGroup === '10-' ? '10 or under' : '11+');\n          member.innerHTML = '<span>' + (isOwner(person) ? '🎄 ' : person.ageGroup === '10-' ? '🧸 ' : '✨ ') +\n            escapeHtml(toShortName(person.fullName)) + '</span><span class=\"preview-meta\">' + age + '</span>';\n          members.appendChild(member);\n        });\n        card.appendChild(members);\n        full.appendChild(card);\n      });\n    }\n\n    function renderFood() {\n      const claims = claimedDishMap();\n      const preview = $('foodPreview');\n      const full = $('foodListFull');\n      preview.innerHTML = '';\n      full.innerHTML = '';\n\n      if (!state.menu.length && claims.size === 0) {\n        preview.innerHTML = '<div class=\"empty-state\">The dish list has not been added yet.</div>';\n        full.innerHTML = '<div class=\"empty-state\">The dish list has not been added yet.</div>';\n        return;\n      }\n\n      const menuItems = state.menu.slice();\n      const extras = [];\n      claims.forEach((owners, key) => {\n        if (!menuItems.some((item) => normalize(item) === key)) {\n          extras.push({ label: parseFoods(owners[0].food).find((food) => normalize(food) === key) || key, owners });\n        }\n      });\n\n      menuItems.slice(0, 4).forEach((item) => {\n        const owners = claims.get(normalize(item)) || [];\n        const row = document.createElement('div');\n        row.className = 'preview-row';\n        row.innerHTML =\n          '<div class=\"preview-main\"><span aria-hidden=\"true\">' + (owners.length ? '✅' : '🍽️') + '</span><span>' + escapeHtml(item) + '</span></div>' +\n          '<div class=\"preview-meta\">' + (owners.length ? owners.map(o => escapeHtml(toShortName(o.fullName))).join(', ') : 'Open') + '</div>';\n        preview.appendChild(row);\n      });\n\n      menuItems.forEach((item) => appendFoodDetail(full, item, claims.get(normalize(item)) || []));\n      extras.forEach((entry) => appendFoodDetail(full, entry.label, entry.owners, true));\n    }\n\n    function appendFoodDetail(container, item, owners, bonus) {\n      const row = document.createElement('div');\n      row.className = 'detail-item';\n      const ownerText = owners.length ? owners.map((owner) => toShortName(owner.fullName)).join(', ') : 'Open to claim';\n      row.innerHTML =\n        '<div class=\"detail-icon\">' + (owners.length ? '✅' : '🍽️') + '</div>' +\n        '<div><strong>' + escapeHtml(item) + '</strong>' +\n        '<div class=\"helper\">' + (bonus ? 'Bonus dish • ' : '') + escapeHtml(ownerText) + '</div></div>';\n      container.appendChild(row);\n    }\n\n    function renderDetails() {\n      const meta = state.meta || {};\n      const details = [\n        ['📅', 'When', [meta.date || 'December 24', meta.time || 'Time listed by the host'].filter(Boolean).join(' • ')],\n        ['📍', 'Where', meta.address || 'Address listed by the host'],\n        ['🎁', 'Kids’ gifts', 'Families may bring a couple of gifts for their own little ones to open. No obligation to bring gifts for anyone else.'],\n        ['🐘', 'Optional White Elephant', '$20 budget • wrapped • no gag gifts • no gift cards • no cash.'],\n        ['🎲', 'Games and prizes', 'Provided by the host.'],\n        ['💬', 'Questions', meta.questions || 'Contact the host for details.']\n      ];\n\n      $('detailsList').innerHTML = '';\n      details.forEach(([icon, title, copy]) => {\n        const item = document.createElement('div');\n        item.className = 'detail-item';\n        item.innerHTML =\n          '<div class=\"detail-icon\">' + icon + '</div>' +\n          '<div><strong>' + escapeHtml(title) + '</strong><div class=\"helper\">' + escapeHtml(copy) + '</div></div>';\n        $('detailsList').appendChild(item);\n      });\n    }\n\n    function renderMyParty() {\n      const panel = $('successPanel');\n      const preview = $('myPartyPreview');\n\n      if (!state.currentOwner) {\n        panel.classList.remove('visible');\n        preview.innerHTML = '';\n        return;\n      }\n\n      const party = getOwnerParty(state.currentOwner);\n      panel.classList.add('visible');\n      $('successHeading').textContent = toShortName(state.currentOwner.fullName) + ' is on the Nice List!';\n      preview.innerHTML = '';\n\n      party.forEach((person) => {\n        const row = document.createElement('div');\n        row.className = 'party-row';\n        const meta = isOwner(person)\n          ? (parseFoods(person.food).length ? parseFoods(person.food).join(', ') : 'No dish selected')\n          : (person.ageGroup === '10-' ? '10 or under' : '11+');\n        row.innerHTML =\n          '<div class=\"party-person\"><span aria-hidden=\"true\">' + (isOwner(person) ? '⭐' : person.ageGroup === '10-' ? '🧸' : '✨') + '</span>' +\n          '<span>' + escapeHtml(toShortName(person.fullName)) + '</span></div>' +\n          '<div class=\"party-meta\">' + escapeHtml(meta) + '</div>';\n        preview.appendChild(row);\n      });\n    }\n\n    function hydrateOwner(name, announce = true) {\n      const owner = findOwnerByName(name);\n      if (!owner) return false;\n      state.currentOwner = owner;\n      $('inviterInput').value = cleanName(owner.fullName);\n      sessionStorage.setItem('christmas2025Name', cleanName(owner.fullName));\n      renderMyParty();\n      if (announce) showToast('Loaded ' + toShortName(owner.fullName) + '’s party.');\n      return true;\n    }\n\n    async function saveRsvp() {\n      const input = $('inviterInput');\n      const name = cleanName(input.value);\n\n      if (!name) {\n        input.setAttribute('aria-invalid', 'true');\n        input.focus();\n        setStatus('Choose a fictional name to save your RSVP.', 'error');\n        return;\n      }\n\n      if (name.length < 2) {\n        input.setAttribute('aria-invalid', 'true');\n        input.focus();\n        setStatus('Please enter a valid name.', 'error');\n        return;\n      }\n\n      const existing = findOwnerByName(name);\n      const payload = {\n        row: existing ? existing.row : null,\n        fullName: name,\n        ageGroup: '11+',\n        food: existing ? parseFoods(existing.food) : [],\n        enteredBy: name\n      };\n\n      setSaving(true);\n      setStatus(existing ? 'Updating your RSVP…' : 'Adding you to Santa’s Nice List…', 'success');\n\n      try {\n        const data = await callBackend('saveAttendee', payload);\n        applyData(data);\n        hydrateOwner(name, false);\n        sessionStorage.setItem('christmas2025Name', name);\n        setStatus('Saved! Add guests or choose a dish whenever you’re ready.', 'success');\n        showToast('🎄 RSVP saved');\n      } catch (error) {\n        setStatus('Your RSVP was not saved. ' + error.message, 'error');\n      } finally {\n        setSaving(false);\n      }\n    }\n\n    function openGuestDialog() {\n      if (!requireOwner()) return;\n      $('guestOwnerText').textContent = 'This guest will be added under ' + toShortName(state.currentOwner.fullName) + '.';\n      $('guestNameInput').value = '';\n      document.querySelectorAll('input[name=\"guestAge\"]').forEach((radio) => radio.checked = false);\n      setDialogStatus('guestStatus', '', '');\n      openDialog('guestDialog', 'guestNameInput');\n    }\n\n    async function saveGuest() {\n      if (!requireOwner()) return;\n      const nameInput = $('guestNameInput');\n      const name = cleanName(nameInput.value);\n      const age = document.querySelector('input[name=\"guestAge\"]:checked');\n\n      if (!name) {\n        nameInput.setAttribute('aria-invalid', 'true');\n        nameInput.focus();\n        setDialogStatus('guestStatus', 'Enter the guest’s full name.', 'error');\n        return;\n      }\n\n      if (!age) {\n        setDialogStatus('guestStatus', 'Choose an age group for this guest.', 'error');\n        return;\n      }\n\n      const existing = state.attendees.find((attendee) =>\n        normalize(attendee.fullName) === normalize(name) &&\n        normalize(attendee.enteredBy) === normalize(state.currentOwner.fullName)\n      );\n\n      $('saveGuestButton').disabled = true;\n      setDialogStatus('guestStatus', 'Saving guest…', '');\n\n      try {\n        const data = await callBackend('saveAttendee', {\n          row: existing ? existing.row : null,\n          fullName: name,\n          ageGroup: age.value,\n          food: [],\n          enteredBy: state.currentOwner.fullName\n        });\n        const ownerName = state.currentOwner.fullName;\n        applyData(data);\n        hydrateOwner(ownerName, false);\n        closeDialog('guestDialog');\n        showToast('🎁 ' + toShortName(name) + ' added');\n        setStatus('Guest added to your party.', 'success');\n      } catch (error) {\n        setDialogStatus('guestStatus', 'Guest was not saved. ' + error.message, 'error');\n      } finally {\n        $('saveGuestButton').disabled = false;\n      }\n    }\n\n    function openDishDialog() {\n      if (!requireOwner()) return;\n      const owner = state.currentOwner;\n      const ownerFoods = new Set(parseFoods(owner.food).map(normalize));\n      const claims = claimedDishMap();\n      const container = $('dishChoices');\n      container.innerHTML = '';\n\n      if (!state.menu.length) {\n        container.innerHTML = '<div class=\"empty-state\">The host has not added dish choices yet.</div>';\n      } else {\n        state.menu.forEach((item) => {\n          const key = normalize(item);\n          const owners = claims.get(key) || [];\n          const selectedByOwner = ownerFoods.has(key);\n          const claimedByOther = owners.some((person) => normalize(person.fullName) !== normalize(owner.fullName));\n\n          const label = document.createElement('label');\n          label.className = 'choice-card' + (claimedByOther && !selectedByOwner ? ' disabled' : '');\n          label.innerHTML =\n            '<input type=\"checkbox\" name=\"dishChoice\" value=\"' + escapeAttribute(item) + '\"' +\n            (selectedByOwner ? ' checked' : '') +\n            (claimedByOther && !selectedByOwner ? ' disabled' : '') + '>' +\n            '<span><span class=\"choice-title\">' + escapeHtml(item) + '</span>' +\n            '<span class=\"choice-help\">' +\n            (selectedByOwner ? 'Your current choice' :\n              claimedByOther ? 'Claimed by ' + owners.map(person => escapeHtml(toShortName(person.fullName))).join(', ') :\n              'Available') +\n            '</span></span>';\n          container.appendChild(label);\n        });\n      }\n\n      setDialogStatus('dishStatus', '', '');\n      openDialog('dishDialog');\n    }\n\n    async function saveDishes() {\n      if (!requireOwner()) return;\n      const selected = Array.from(document.querySelectorAll('input[name=\"dishChoice\"]:checked')).map((input) => input.value);\n      $('saveDishButton').disabled = true;\n      setDialogStatus('dishStatus', 'Saving dishes…', '');\n\n      try {\n        const ownerName = state.currentOwner.fullName;\n        const data = await callBackend('saveAttendee', {\n          row: state.currentOwner.row,\n          fullName: ownerName,\n          ageGroup: state.currentOwner.ageGroup || '11+',\n          food: selected,\n          enteredBy: state.currentOwner.enteredBy || ownerName\n        });\n        applyData(data);\n        hydrateOwner(ownerName, false);\n        closeDialog('dishDialog');\n        showToast(selected.length ? '🍽️ Dishes saved' : 'Dish choices cleared');\n        setStatus('Your dish choices were updated.', 'success');\n      } catch (error) {\n        setDialogStatus('dishStatus', 'Dishes were not saved. ' + error.message, 'error');\n      } finally {\n        $('saveDishButton').disabled = false;\n      }\n    }\n\n    function requireOwner() {\n      const name = cleanName($('inviterInput').value);\n      if (!state.currentOwner && name) hydrateOwner(name, false);\n      if (state.currentOwner) return true;\n      setStatus('Save your own RSVP first, then add guests or dishes.', 'error');\n      $('inviterInput').focus();\n      return false;\n    }\n\n    function openNiceListDialog() { openDialog('niceListDialog'); }\n    function openFoodDialog() { openDialog('foodDialog'); }\n    function openDetailsDialog() { openDialog('detailsDialog'); }\n\n    function openDialog(id, focusId) {\n      const dialog = $(id);\n      if (!dialog) return;\n      if (typeof dialog.showModal === 'function') {\n        dialog.showModal();\n      } else {\n        dialog.setAttribute('open', '');\n      }\n      window.setTimeout(() => {\n        if (focusId && $(focusId)) $(focusId).focus();\n      }, 40);\n    }\n\n    function closeDialog(id) {\n      const dialog = $(id);\n      if (!dialog) return;\n      if (typeof dialog.close === 'function') dialog.close();\n      else dialog.removeAttribute('open');\n    }\n\n    function scrollToRsvp() {\n      document.querySelector('main').scrollIntoView({ behavior: 'smooth', block: 'start' });\n      window.setTimeout(() => $('inviterInput').focus({ preventScroll: true }), 300);\n    }\n\n    function setSaving(saving) {\n      state.saving = saving;\n      $('rsvpButton').disabled = saving;\n      $('rsvpButton').textContent = saving ? 'Saving…' : '⭐ Save my RSVP';\n    }\n\n    function setStatus(message, type) {\n      const el = $('status');\n      el.textContent = message || '';\n      el.className = 'status' + (message && type ? ' ' + type : '');\n    }\n\n    function setDialogStatus(id, message, type) {\n      const el = $(id);\n      el.textContent = message || '';\n      el.className = 'status' + (message && type ? ' ' + type : '');\n    }\n\n    let toastTimer;\n    function showToast(message) {\n      const toast = $('toast');\n      toast.textContent = message;\n      toast.classList.add('visible');\n      window.clearTimeout(toastTimer);\n      toastTimer = window.setTimeout(() => toast.classList.remove('visible'), 2400);\n    }\n\n    function escapeHtml(value) {\n      return String(value == null ? '' : value)\n        .replace(/&/g, '&amp;')\n        .replace(/</g, '&lt;')\n        .replace(/>/g, '&gt;')\n        .replace(/\"/g, '&quot;')\n        .replace(/'/g, '&#039;');\n    }\n\n    function escapeAttribute(value) {\n      return escapeHtml(value).replace(/`/g, '&#096;');\n    }\n  </script>\n</body>\n</html>\n\n","thanksgiving":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Thanksgiving Demo</title><style>\n:root{--ink:#392116;--rust:#a44425;--cream:#fff9e9;--gold:#e3a64b;--green:#526647;--paper:#fffef8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#f4e8d3;color:var(--ink);font:16px/1.5 system-ui,sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #e8a53f;outline-offset:3px}.top{background:#4c281f;color:#fff3db;text-align:center;padding:8px;font-size:.73rem;font-weight:800;letter-spacing:.15em}.wrap{max-width:1200px;margin:auto;padding:18px}.hero{position:relative;overflow:hidden;background:linear-gradient(115deg,#5b241a,#a64827 64%,#bb7437);border:5px solid #f4d49d;border-radius:30px;color:#fff9ed;padding:44px;box-shadow:0 22px 50px #632d201f}.hero:after{content:'🍂';position:absolute;font-size:165px;right:7%;top:2%;opacity:.32;animation:sway 5s ease-in-out infinite}.hero small{color:#ffcf86;letter-spacing:.18em;font-weight:800}.hero h1{font:700 clamp(2.8rem,6vw,5.5rem)/.98 Georgia,serif;letter-spacing:-.05em;margin:14px 0}.hero p{font-size:1.07rem;max-width:540px;color:#fff1df}.hero-content{position:relative;z-index:2}.badge{display:inline-block;padding:8px 12px;background:#fff4d920;border:1px solid #ffffff65;border-radius:999px;font-size:.84rem}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}.btn{border:0;border-radius:999px;background:var(--rust);color:white;padding:13px 20px;font-weight:800;min-height:46px}.btn.gold{background:#f7c667;color:#512718}.btn.light{background:#fff2d9;color:#693120}.btn.outline{background:transparent;color:var(--rust);border:1px solid #cda78c}.btn:hover{transform:translateY(-2px)}.leaf{position:absolute;top:-30px;font-size:25px;opacity:.7;animation:fall 9s linear infinite}.leaf:nth-child(2){left:71%;animation-delay:-4s}.leaf:nth-child(3){left:88%;animation-delay:-7s}@keyframes fall{to{transform:translate(-65px,330px) rotate(240deg);opacity:0}}@keyframes sway{50%{transform:rotate(14deg) translateY(8px)}}.facts{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}.fact,.card{background:var(--paper);border:1px solid #e8d3b5;border-radius:20px;box-shadow:0 8px 24px #7543230d}.fact{padding:16px}.label{font-size:.72rem;letter-spacing:.11em;font-weight:800;text-transform:uppercase;color:#a04f31}.fact strong{display:block;margin-top:3px;font-size:1rem}.fact span{display:block;color:#795f4e;font-size:.82rem}.layout{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px;align-items:start}.stack{display:grid;gap:16px}.card{padding:24px}.eyebrow{font-size:.72rem;color:var(--rust);font-weight:900;letter-spacing:.14em;text-transform:uppercase}h2{font:700 1.8rem Georgia,serif;margin:5px 0 8px}h3{font:700 1.1rem Georgia,serif}.muted{color:#785f50;font-size:.9rem}.tabs{display:flex;gap:8px;flex-wrap:wrap}.tabs button{flex:1;min-width:100px;border:1px solid #e3cfb4;border-radius:12px;padding:12px;background:#fff9ef;color:#674432;font-weight:750}.tabs button[aria-pressed=true]{background:#9c4328;color:white;border-color:#9c4328}label{display:block;font-weight:700;font-size:.87rem;margin:14px 0 6px}input,select,textarea{width:100%;padding:12px;border:1px solid #d5c1ac;border-radius:11px;background:white;color:var(--ink)}textarea{resize:vertical}.columns{display:grid;grid-template-columns:1fr 1fr;gap:12px}.status{min-height:24px;font-size:.9rem;color:#5d6b3d;margin:10px 0}.dish{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:12px 0;border-bottom:1px solid #f0e3d0}.dish:last-child{border:0}.pill{font-size:.74rem;font-weight:800;padding:5px 9px;background:#eaf0df;color:#526b36;border-radius:50px}.pill.claimed{background:#f5e4d8;color:#a2492d}.guest{display:flex;justify-content:space-between;gap:10px;padding:9px 0;border-bottom:1px solid #f0e3d0}.timeline{display:grid;grid-template-columns:60px 1fr;gap:12px;border-left:2px solid #edc688;padding:0 0 16px 14px;margin-left:6px}.timeline b{color:#a24424}.count{float:right;background:#f6e6c8;color:#8d4828;border-radius:50px;padding:5px 11px;font-weight:900}.footer{text-align:center;color:#8b6c55;padding:30px 0}.sticky{display:none}dialog{border:0;border-radius:22px;box-shadow:0 20px 80px #30140866;width:min(560px,94vw);max-height:88vh;overflow:auto;padding:24px}dialog::backdrop{background:#26130caa}dialog h2{margin-top:0}.close{float:right;background:#f5e7d4;color:#684330;border:0;border-radius:50%;width:38px;height:38px}.sample{background:#fff0ce;color:#85542f;border-radius:12px;padding:10px;font-size:.82rem;margin:12px 0}a{color:#9c4328} @media(max-width:720px){.wrap{padding:10px 10px 90px}.hero{padding:26px 20px;border-radius:22px}.hero:after{font-size:90px;right:0;top:25%}.hero h1{font-size:3.1rem;max-width:310px}.hero p{max-width:300px}.facts{grid-template-columns:1fr 1fr}.fact{padding:12px}.layout{grid-template-columns:1fr}.card{padding:19px}.sticky{display:flex;position:fixed;bottom:0;left:0;right:0;background:#fffaf1;padding:9px 14px calc(9px + env(safe-area-inset-bottom));box-shadow:0 -6px 25px #45240b22;z-index:5;gap:10px}.sticky .btn{flex:1}.sticky a{align-self:center;font-weight:800}.columns{grid-template-columns:1fr 1fr}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;scroll-behavior:auto!important;transition:none!important}}\n</style><style>select.demo-select{display:block;width:100%;min-height:48px;padding:12px;border:1px solid #b7c6bf;border-radius:12px;background:#fff;color:#183b37;font:inherit}select.demo-select:focus-visible{outline:3px solid #986119;outline-offset:3px}</style></head><body><div style=\"padding:10px 18px;background:#fff3ce;color:#49330c;font:600 14px/1.5 system-ui;text-align:center\" role=\"note\">Interactive portfolio demo · Fictional sample data only. Choose from fictional dropdown options. No personal information can be entered.</div><div class=\"top\">🍁 A LITTLE GATHERING, A LOT TO BE THANKFUL FOR 🍁</div><div class=\"wrap\"><header class=\"hero\"><div class=\"leaf\" style=\"left:58%\">🍁</div><div class=\"leaf\">🍂</div><div class=\"leaf\">🍁</div><div class=\"hero-content\"><small>THE MAPLE FAMILY INVITES YOU</small><h1>Come gather<br>at our table.</h1><p>A cozy Thanksgiving feast, good company, and plenty of pie. There’s a place for you here.</p><span class=\"badge\">✨ A fictional event · interactive demo</span><div class=\"actions\"><a class=\"btn gold\" href=\"#rsvp\" style=\"text-decoration:none\">RSVP to the feast →</a><a class=\"btn light\" href=\"#potluck\" style=\"text-decoration:none\">See the potluck</a></div></div></header><div class=\"facts\"><div class=\"fact\"><div class=\"label\">📅 When</div><strong>Thursday, Nov 26</strong><span>2026 · Doors open 3 PM</span></div><div class=\"fact\"><div class=\"label\">🍽 Dinner</div><strong>4:00 PM</strong><span>Come hungry!</span></div><div class=\"fact\"><div class=\"label\">📍 Where</div><strong>123 Harvest Lane</strong><span>Maplewood · fictional address</span></div><div class=\"fact\"><div class=\"label\">💌 RSVP by</div><strong>November 19</strong><span>So we can set your place</span></div></div><div class=\"layout\"><div class=\"stack\"><section class=\"card\" id=\"rsvp\"><div class=\"eyebrow\">A seat at the table</div><h2>Can you make it?</h2><p class=\"muted\">Let us know in one quick step. Your dish is completely optional.</p><form id=\"rsvpForm\"><div class=\"tabs\" role=\"group\" aria-label=\"Attendance\"><button type=\"button\" data-response=\"Going\" aria-pressed=\"true\">🙌 Going</button><button type=\"button\" data-response=\"Maybe\" aria-pressed=\"false\">🤔 Maybe</button><button type=\"button\" data-response=\"Can't go\" aria-pressed=\"false\">💌 Can't go</button></div><label for=\"name\">Your name *</label><select class=\"demo-select\" id=\"name\" name=\"name\" required aria-label=\"Fictional name\"><option value=\"Alex Example\">Alex Example</option><option value=\"Morgan Sample\">Morgan Sample</option><option value=\"Taylor Demo\">Taylor Demo</option><option value=\"Casey Placeholder\">Casey Placeholder</option><option value=\"Holly Snow\">Holly Snow</option><option value=\"Noel Snow\">Noel Snow</option><option value=\"Nick Frost\">Nick Frost</option><option value=\"Jolly Evergreen\">Jolly Evergreen</option><option value=\"Holly Maple\">Holly Maple</option><option value=\"Oliver Acorn\">Oliver Acorn</option><option value=\"Autumn Fields\">Autumn Fields</option></select><div class=\"columns\"><div><label for=\"adults\">Adults</label><select id=\"adults\"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div><div><label for=\"kids\">Kids</label><select id=\"kids\"><option>0</option><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option></select></div></div><label for=\"dish\">Bringing something? <span class=\"muted\">Optional</span></label><select id=\"dish\"><option value=\"\">I'll decide later / not bringing a dish</option></select><label for=\"notes\">Dietary needs or a note for the host <span class=\"muted\">Optional</span></label><select class=\"demo-select\" id=\"notes\" name=\"notes\" aria-label=\"Sample note\"><option value=\"\">None / not selected</option><option value=\"Fictional sample signup\">Fictional sample signup</option><option value=\"Enjoy the sample meal!\">Enjoy the sample meal!</option><option value=\"Demo delivery only.\">Demo delivery only.</option></select><div class=\"status\" id=\"formStatus\" role=\"status\" aria-live=\"polite\"></div><button class=\"btn\" id=\"save\" type=\"submit\">Save my RSVP →</button> <button type=\"button\" class=\"btn outline\" id=\"reset\">Start over</button></form><div class=\"sample\">This is a demo with fictional information. Use sample names and notes.</div></section><section class=\"card\"><div class=\"eyebrow\">The plan</div><h2>A lovely little itinerary</h2><div class=\"timeline\"><b>3:00</b><div><strong>Doors open</strong><div class=\"muted\">Settle in, say hello, and enjoy a snack.</div></div></div><div class=\"timeline\"><b>4:00</b><div><strong>Gather around the table</strong><div class=\"muted\">Dinner is served, family style.</div></div></div><div class=\"timeline\"><b>5:30</b><div><strong>Pie, games & gratitude</strong><div class=\"muted\">Stay a little longer for dessert and fun.</div></div></div></section></div><div class=\"stack\"><section class=\"card\" id=\"potluck\"><span class=\"count\" id=\"openCount\">— open</span><div class=\"eyebrow\">Share the feast</div><h2>The potluck table</h2><p class=\"muted\">Choose an open dish when you RSVP. Claimed items are shown here.</p><div id=\"dishList\" aria-live=\"polite\">Loading…</div></section><section class=\"card\"><span class=\"count\" id=\"guestCount\">— going</span><div class=\"eyebrow\">Good company</div><h2>Who's coming</h2><p class=\"muted\">A little preview of the people around the table.</p><div id=\"guestList\">Loading…</div><button class=\"btn outline\" style=\"margin-top:16px\" onclick=\"openGuestList()\">View guest list</button></section><section class=\"card\"><div class=\"eyebrow\">Good to know</div><h2>Make yourself at home</h2><p>🧡 <strong>What to bring:</strong> A favorite dish if you’d like—your company is enough.</p><p>👟 <strong>Dress:</strong> Cozy and casual.</p><p>♿ <strong>Accessibility:</strong> Step-free entrance in this fictional example.</p><p>💬 <strong>Questions?</strong> Contact the host through your usual channel.</p><button class=\"btn outline\" onclick=\"downloadCalendar()\">＋ Add to calendar</button></section></div></div><footer class=\"footer\">Made for gathering, gratitude, and second helpings. 🍂<br> <button class=\"btn outline\" onclick=\"copyLink()\">Copy demo link</button></footer></div><div class=\"sticky\"><a href=\"#potluck\">🍽 Potluck</a><a href=\"#rsvp\" class=\"btn\">RSVP →</a></div><dialog id=\"guestDialog\"><button class=\"close\" onclick=\"guestDialog.close()\" aria-label=\"Close\">✕</button><div class=\"eyebrow\">Good company</div><h2>Guest list</h2><div id=\"allGuests\"></div></dialog><script>\nconst dishes=['Mashed potatoes','Stuffing','Green bean casserole','Dinner rolls','Pumpkin pie','Apple pie','Drinks','Mac and cheese'];let entries=[],response='Going',adminPassword='';const $=id=>document.getElementById(id);const escapeHtml=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));async function api(path,data){return new Promise((resolve,reject)=>google.script.run.withSuccessHandler(resolve).withFailureHandler(e=>reject(new Error(e.message||'Please try again.'))).apiAction(path,data||{}))}function render(){const going=entries.filter(x=>x.response==='Going');let count=going.reduce((n,x)=>n+Number(x.adults)+Number(x.kids),0);$('guestCount').textContent=count+' going';let taken=new Map(entries.filter(x=>x.dish&&x.response==='Going').map(x=>[x.dish,x.name]));$('openCount').textContent=(dishes.length-taken.size)+' open';$('dishList').innerHTML=dishes.map(x=>'<div class=\"dish\"><strong>🍽️ '+escapeHtml(x)+'</strong><span class=\"pill '+(taken.has(x)?'claimed':'')+'\">'+(taken.has(x)?'✓ '+escapeHtml(taken.get(x)):'Available')+'</span></div>').join('');let selected=$('dish').value;$('dish').innerHTML='<option value=\"\">I’ll decide later / not bringing a dish</option>'+dishes.map(x=>'<option value=\"'+escapeHtml(x)+'\" '+(taken.has(x)&&x!==selected?'disabled':'')+'>'+escapeHtml(x)+(taken.has(x)&&x!==selected?' — claimed':'')+'</option>').join('');$('dish').value=selected;$('guestList').innerHTML=entries.slice(0,4).map(x=>'<div class=\"guest\"><strong>'+escapeHtml(x.name)+'</strong><span class=\"muted\">'+escapeHtml(x.response)+(x.response==='Going'?' · '+(Number(x.adults)+Number(x.kids))+' guests':'')+'</span></div>').join('')||'<p class=\"muted\">Be the first to RSVP.</p>'}async function refresh(){entries=(await api('/api/list')).entries;render()}document.querySelectorAll('[data-response]').forEach(b=>b.onclick=()=>{response=b.dataset.response;document.querySelectorAll('[data-response]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)))});$('rsvpForm').onsubmit=async e=>{e.preventDefault();let b=$('save');b.disabled=true;$('formStatus').textContent='Saving…';try{await api('/api/save',{name:$('name').value.trim(),response,adults:Number($('adults').value),kids:Number($('kids').value),dish:$('dish').value,notes:$('notes').value.trim()});await refresh();$('formStatus').textContent='Saved! Thank you for letting us know.'}catch(x){$('formStatus').textContent=x.message}finally{b.disabled=false}};$('reset').onclick=()=>{$('rsvpForm').reset();$('formStatus').textContent='';document.querySelector('[data-response=\"Going\"]').click()};function openGuestList(){$('allGuests').innerHTML=entries.map(x=>'<div class=\"guest\"><strong>'+escapeHtml(x.name)+'</strong><span>'+escapeHtml(x.response)+(x.response==='Going'?' · '+(Number(x.adults)+Number(x.kids))+' guests':'')+'</span></div>').join('');$('guestDialog').showModal()}function copyLink(){navigator.clipboard.writeText(location.href).then(()=>alert('Demo link copied.')).catch(()=>alert('Copy the address from your browser.'))}function downloadCalendar(){let ics=['BEGIN:VCALENDAR','VERSION:2.0','BEGIN:VEVENT','DTSTART:20261126T210000Z','DTEND:20261127T000000Z','SUMMARY:Thanksgiving Demo','LOCATION:123 Harvest Lane (fictional)','DESCRIPTION:Fictional demo event','END:VEVENT','END:VCALENDAR'].join('\\r\\n');let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([ics],{type:'text/calendar'}));a.download='thanksgiving-demo.ics';a.click();URL.revokeObjectURL(a.href)}refresh().catch(()=>{$('formStatus').textContent='Could not load the demo. Please refresh.'});\n</script></body></html>\n\n","decker":"<!DOCTYPE html>\n<html>\n<head>\n  <base target=\"_top\">\n  <meta charset=\"UTF-8\">\n\n  <style>\n    :root {\n      --primary: #2563eb;\n      --primary-dark: #1d4ed8;\n      --background: #f4f7fb;\n      --card: #ffffff;\n      --text: #172033;\n      --muted: #64748b;\n      --border: #dbe2ea;\n      --success: #166534;\n      --success-background: #dcfce7;\n      --error: #991b1b;\n      --error-background: #fee2e2;\n      --highlight: #eff6ff;\n    }\n\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      margin: 0;\n      background: var(--background);\n      color: var(--text);\n      font-family:\n        -apple-system,\n        BlinkMacSystemFont,\n        \"Segoe UI\",\n        Roboto,\n        Arial,\n        sans-serif;\n    }\n\n    .page {\n      width: min(100%, 900px);\n      margin: 0 auto;\n      padding: 20px 14px 50px;\n    }\n\n    .hero {\n      padding: 26px 20px;\n      margin-bottom: 18px;\n      border-radius: 22px;\n      background: linear-gradient(135deg, #2563eb, #60a5fa);\n      color: white;\n      box-shadow: 0 12px 30px rgba(37, 99, 235, 0.22);\n    }\n\n    .hero h1 {\n      margin: 0 0 8px;\n      font-size: clamp(28px, 7vw, 42px);\n      line-height: 1.05;\n    }\n\n    .hero p {\n      margin: 0;\n      line-height: 1.5;\n    }\n\n    .card {\n      background: var(--card);\n      border: 1px solid var(--border);\n      border-radius: 20px;\n      padding: 20px;\n      margin-bottom: 18px;\n      box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);\n    }\n\n    h2 {\n      margin: 0 0 6px;\n    }\n\n    .subtitle {\n      margin: 0 0 18px;\n      color: var(--muted);\n      line-height: 1.45;\n    }\n\n    .form-grid {\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 16px;\n    }\n\n    .field {\n      display: flex;\n      flex-direction: column;\n      gap: 7px;\n    }\n\n    .full-width {\n      grid-column: 1 / -1;\n    }\n\n    label {\n      font-weight: 700;\n    }\n\n    input,\n    select,\n    textarea {\n      width: 100%;\n      min-height: 48px;\n      border: 1px solid #cbd5e1;\n      border-radius: 12px;\n      padding: 12px;\n      font: inherit;\n      font-size: 16px;\n      background: white;\n    }\n\n    textarea {\n      min-height: 95px;\n    }\n\n    button {\n      width: 100%;\n      min-height: 52px;\n      margin-top: 18px;\n      border: 0;\n      border-radius: 13px;\n      background: var(--primary);\n      color: white;\n      font: inherit;\n      font-weight: 800;\n      font-size: 17px;\n    }\n\n    button:disabled {\n      opacity: .6;\n    }\n\n    .required {\n      color: #dc2626;\n    }\n\n    .message {\n      display: none;\n      margin-top: 15px;\n      padding: 13px;\n      border-radius: 12px;\n      font-weight: 700;\n    }\n\n    .success {\n      display: block;\n      background: var(--success-background);\n      color: var(--success);\n    }\n\n    .error {\n      display: block;\n      background: var(--error-background);\n      color: var(--error);\n    }\n\n    .preference-box {\n      padding: 16px;\n      border-radius: 14px;\n      background: var(--highlight);\n      border: 1px solid #bfdbfe;\n      line-height: 1.5;\n    }\n\n    .preference-box h3 {\n      margin-top: 0;\n      margin-bottom: 12px;\n    }\n\n    .restaurant {\n      margin-bottom: 14px;\n    }\n\n    .restaurant:last-child {\n      margin-bottom: 0;\n    }\n\n    .restaurant strong {\n      display: block;\n      margin-bottom: 3px;\n    }\n\n    .schedule-list {\n      display: grid;\n      gap: 12px;\n    }\n\n    .entry {\n      border: 1px solid var(--border);\n      border-radius: 14px;\n      padding: 15px;\n      background: #fbfdff;\n    }\n\n    .entry-header {\n      display: flex;\n      justify-content: space-between;\n      gap: 10px;\n    }\n\n    .badge {\n      background: #dbeafe;\n      color: #1e40af;\n      border-radius: 999px;\n      padding: 5px 9px;\n      font-size: 13px;\n      font-weight: 800;\n      white-space: nowrap;\n    }\n\n    .entry p {\n      margin: 7px 0 0;\n      line-height: 1.4;\n    }\n\n    .muted {\n      color: var(--muted);\n      font-size: 14px;\n    }\n\n    @media (min-width: 700px) {\n      .form-grid {\n        grid-template-columns: 1fr 1fr;\n      }\n\n      button[type=\"submit\"] {\n        width: auto;\n        min-width: 220px;\n      }\n    }\n  </style>\n<style>select.demo-select{display:block;width:100%;min-height:48px;padding:12px;border:1px solid #b7c6bf;border-radius:12px;background:#fff;color:#183b37;font:inherit}select.demo-select:focus-visible{outline:3px solid #986119;outline-offset:3px}</style></head>\n\n<body><div style=\"padding:10px 18px;background:#fff3ce;color:#49330c;font:600 14px/1.5 system-ui;text-align:center\" role=\"note\">Interactive portfolio demo · Fictional sample data only. Choose from fictional dropdown options. No personal information can be entered.</div>\n\n  <main class=\"page\">\n\n    <section class=\"hero\">\n      <h1>Decker Family Meal Sign-Up</h1>\n      <p>\n        Sign up to get the Deckers a meal, delivery, or gift card.\n      </p>\n    </section>\n\n    <section class=\"card\">\n\n      <h2>Sign up to help</h2>\n\n      <p class=\"subtitle\">\n        Choose what you'd like to provide.\n      </p>\n\n      <form id=\"mealForm\">\n\n        <div class=\"form-grid\">\n\n          <div class=\"field\">\n            <label>\n              Your name\n              <span class=\"required\">*</span>\n            </label>\n\n            <select class=\"demo-select\" id=\"name\" name=\"name\" required aria-label=\"Fictional name\"><option value=\"Alex Example\">Alex Example</option><option value=\"Morgan Sample\">Morgan Sample</option><option value=\"Taylor Demo\">Taylor Demo</option><option value=\"Casey Placeholder\">Casey Placeholder</option><option value=\"Holly Snow\">Holly Snow</option><option value=\"Noel Snow\">Noel Snow</option><option value=\"Nick Frost\">Nick Frost</option><option value=\"Jolly Evergreen\">Jolly Evergreen</option><option value=\"Holly Maple\">Holly Maple</option><option value=\"Oliver Acorn\">Oliver Acorn</option><option value=\"Autumn Fields\">Autumn Fields</option></select>\n          </div>\n\n          <div class=\"field\">\n            <label>\n              Date\n              <span class=\"required\">*</span>\n            </label>\n\n            <select class=\"demo-select\" id=\"date\" name=\"date\" required aria-label=\"Sample date\">__DEMO_DATE_OPTIONS__</select>\n          </div>\n\n          <div class=\"field\">\n            <label>\n              Type\n              <span class=\"required\">*</span>\n            </label>\n\n            <select\n              id=\"mealType\"\n              required\n            >\n              <option value=\"\">Choose one</option>\n              <option value=\"Breakfast\">Breakfast</option>\n              <option value=\"Lunch\">Lunch</option>\n              <option value=\"Dinner\">Dinner</option>\n              <option value=\"Snack\">Snack</option>\n              <option value=\"Dessert\">Dessert</option>\n              <option value=\"DoorDash\">DoorDash</option>\n              <option value=\"Gift Card\">Gift Card</option>\n              <option value=\"Other\">Other</option>\n            </select>\n          </div>\n\n          <div class=\"field\">\n            <label>\n              Approximate delivery time\n            </label>\n\n            <select class=\"demo-select\" id=\"deliveryTime\" name=\"deliveryTime\" aria-label=\"Sample delivery time\"><option value=\"\">None / not selected</option><option value=\"09:00\">09:00</option><option value=\"12:00\">12:00</option><option value=\"15:00\">15:00</option><option value=\"17:30\">17:30</option><option value=\"18:00\">18:00</option></select>\n          </div>\n\n          <div class=\"preference-box full-width\">\n\n            <h3>Favorite restaurants & orders</h3>\n\n            <div class=\"restaurant\">\n              <strong>L & A China Cafe — Fictional example</strong>\n              Beef & broccoli and fried rice.\n              The boys like plain chicken from the kids menu\n              with sauce on the side.\n            </div>\n\n            <div class=\"restaurant\">\n              <strong>Pepperoni’s Pizza — Fictional example</strong>\n              The boys like plain cheese pizza and pepperoni rolls.\n              The fictional sample parents like the Italian Texano pizza.\n            </div>\n\n            <div class=\"restaurant\">\n              <strong>Chick-fil-A</strong>\n              The boys like chicken nuggets and mac & cheese.\n            </div>\n\n          </div>\n\n          <div class=\"preference-box full-width\">\n\n            <h3>Gift card ideas</h3>\n\n            <p>\n              DoorDash, Chick-fil-A, Pepperoni’s Pizza,\n              or another restaurant gift card would all be helpful.\n            </p>\n\n            <div class=\"field\">\n              <label>\n                Gift card amount\n                <span class=\"muted\">(optional)</span>\n              </label>\n\n              <select class=\"demo-select\" id=\"giftCardAmount\" name=\"giftCardAmount\" aria-label=\"Sample gift-card amount\"><option value=\"\">None / not selected</option><option value=\"25\">25</option><option value=\"50\">50</option><option value=\"100\">100</option></select>\n            </div>\n\n          </div>\n\n          <div class=\"field full-width\">\n\n            <label>\n              What are you bringing?\n            </label>\n\n            <select class=\"demo-select\" id=\"food\" name=\"food\" aria-label=\"Sample item\"><option value=\"Vegetable lasagna\">Vegetable lasagna</option><option value=\"Soup and salad\">Soup and salad</option><option value=\"Fruit basket\">Fruit basket</option><option value=\"Sample pizza\">Sample pizza</option><option value=\"Sample gift card\">Sample gift card</option><option value=\"Sample baby blanket\">Sample baby blanket</option></select>\n\n          </div>\n\n          <div class=\"field full-width\">\n            <label>\n              Sample note (public)\n            </label>\n\n            <select class=\"demo-select\" id=\"notes\" name=\"notes\" aria-label=\"Sample note\"><option value=\"\">None / not selected</option><option value=\"Fictional sample signup\">Fictional sample signup</option><option value=\"Enjoy the sample meal!\">Enjoy the sample meal!</option><option value=\"Demo delivery only.\">Demo delivery only.</option></select>\n          </div>\n\n        </div>\n\n        <button\n          id=\"submitButton\"\n          type=\"submit\"\n        >\n          Add My Sign-Up\n        </button>\n\n        <div\n          id=\"formMessage\"\n          class=\"message\"\n        ></div>\n\n      </form>\n\n    </section>\n\n    <section class=\"card\">\n\n      <h2>Current sign-ups</h2>\n\n      <div id=\"schedule\">\n        Loading...\n      </div>\n\n    </section>\n\n  </main>\n\n  <script>\n\n    const mealType =\n      document.getElementById('mealType');\n\n    const food =\n      document.getElementById('food');\n\n    const form =\n      document.getElementById('mealForm');\n\n    const message =\n      document.getElementById('formMessage');\n\n    const submitButton =\n      document.getElementById('submitButton');\n\n    document.addEventListener(\n      'DOMContentLoaded',\n      loadSchedule\n    );\n\n    form.addEventListener('submit', event => {\n\n      event.preventDefault();\n\n      if (!form.reportValidity()) {\n        return;\n      }\n\n      submitButton.disabled = true;\n      submitButton.textContent = 'Adding...';\n\n      const data = {\n\n        name:\n          document.getElementById('name').value,\n\n        date:\n          document.getElementById('date').value,\n\n        mealType:\n          mealType.value,\n\n        food:\n          food.value,\n\n        deliveryTime:\n          formatTime(\n            document.getElementById('deliveryTime').value\n          ),\n\n        notes:\n          document.getElementById('notes').value,\n\n        giftCardAmount:\n          document.getElementById('giftCardAmount').value\n\n      };\n\n      google.script.run\n\n        .withSuccessHandler(result => {\n\n          message.textContent = result.message;\n          message.className = 'message success';\n\n          form.reset();\n          loadSchedule();\n\n          submitButton.disabled = false;\n          submitButton.textContent = 'Add My Sign-Up';\n\n        })\n\n        .withFailureHandler(error => {\n\n          message.textContent =\n            error.message || 'Something went wrong.';\n\n          message.className = 'message error';\n\n          submitButton.disabled = false;\n          submitButton.textContent = 'Add My Sign-Up';\n\n        })\n\n        .submitMealSignUp(data);\n\n    });\n\n    function loadSchedule() {\n\n      google.script.run\n\n        .withSuccessHandler(entries => {\n\n          const schedule =\n            document.getElementById('schedule');\n\n          if (!entries.length) {\n\n            schedule.innerHTML =\n              '<p class=\"muted\">No one has signed up yet.</p>';\n\n            return;\n          }\n\n          schedule.innerHTML =\n            '<div class=\"schedule-list\">' +\n\n            entries.map(entry => {\n\n              const giftCardLine =\n                entry.giftCardAmount\n                ? `<p><strong>Gift card:</strong> ${escapeHtml(entry.giftCardAmount)}</p>`\n                : '';\n\n              const foodLine =\n                entry.food\n                ? `<p><strong>Bringing:</strong> ${escapeHtml(entry.food)}</p>`\n                : '';\n\n              const timeLine =\n                entry.deliveryTime\n                ? `<p><strong>Time:</strong> ${escapeHtml(entry.deliveryTime)}</p>`\n                : '';\n\n              const notesLine =\n                entry.notes\n                ? `<p class=\"muted\">${escapeHtml(entry.notes)}</p>`\n                : '';\n\n              return `\n\n                <div class=\"entry\">\n\n                  <div class=\"entry-header\">\n\n                    <div>\n                      <strong>\n                        ${escapeHtml(entry.name)}\n                      </strong>\n\n                      <div class=\"muted\">\n                        ${escapeHtml(entry.date)}\n                      </div>\n                    </div>\n\n                    <span class=\"badge\">\n                      ${escapeHtml(entry.mealType)}\n                    </span>\n\n                  </div>\n\n                  ${foodLine}\n                  ${giftCardLine}\n                  ${timeLine}\n                  ${notesLine}\n\n                </div>\n\n              `;\n\n            }).join('') +\n\n            '</div>';\n\n        })\n\n        .getMealSignUps();\n\n    }\n\n    function formatTime(time) {\n\n      if (!time) return '';\n\n      const [hours, minutes] =\n        time.split(':');\n\n      let hour = Number(hours);\n\n      const suffix =\n        hour >= 12 ? 'PM' : 'AM';\n\n      hour =\n        hour % 12 || 12;\n\n      return `${hour}:${minutes} ${suffix}`;\n    }\n\n    function escapeHtml(value) {\n\n      return String(value || '')\n        .replaceAll('&', '&amp;')\n        .replaceAll('<', '&lt;')\n        .replaceAll('>', '&gt;')\n        .replaceAll('\"', '&quot;')\n        .replaceAll(\"'\", '&#039;');\n\n    }\n\n  </script>\n\n</body>\n</html>","rafa":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <base target=\"_top\">\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>A little love for Rafael</title>\n\n  <style>\n    :root {\n      --ink: #254962;\n      --muted: #5a7283;\n      --blue: #dceef9;\n      --pale: #f1f8fc;\n      --line: #d9e6ef;\n      --deep: #315f82;\n      --cream: #fffdf8;\n      --gold: #c2a36b;\n    }\n\n    * { box-sizing: border-box; }\n\n    body {\n      margin: 0;\n      background: var(--cream);\n      color: var(--ink);\n      font: 16px/1.55 system-ui, -apple-system,\n        BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n\n    button, input, select, textarea { font: inherit; }\n\n    button, a, input, select, textarea {\n      -webkit-tap-highlight-color: transparent;\n    }\n\n    button { cursor: pointer; }\n    button:disabled { cursor: wait; opacity: .65; }\n    a { color: var(--deep); }\n\n    .topbar {\n      max-width: 1160px;\n      margin: auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 23px 28px;\n      font-size: 13px;\n      letter-spacing: .08em;\n    }\n\n    .brand { font-weight: 750; }\n\n    .topbar a {\n      text-decoration: none;\n      letter-spacing: 0;\n      font-weight: 650;\n    }\n\n    .hero {\n      position: relative;\n      overflow: hidden;\n      background: linear-gradient(155deg, #edf7fc, #dcecf8);\n      text-align: center;\n      padding: 54px 24px 68px;\n      border-top: 1px solid #e2edf3;\n      border-bottom: 1px solid #dbe7ef;\n    }\n\n    .eyebrow {\n      text-transform: uppercase;\n      letter-spacing: .21em;\n      font-size: 11px;\n      font-weight: 750;\n      margin: 0 0 17px;\n      color: #52748d;\n    }\n\n    .hero h1 {\n      font: normal clamp(48px, 7vw, 80px)/1.08\n        Georgia, \"Times New Roman\", serif;\n      letter-spacing: -.045em;\n      margin: 0;\n      position: relative;\n      z-index: 1;\n    }\n\n    .hero h1 em {\n      font-weight: normal;\n      color: #3e7398;\n    }\n\n    .hero p.lede {\n      max-width: 520px;\n      margin: 23px auto 0;\n      color: #47697f;\n      font-size: 17px;\n      position: relative;\n      z-index: 1;\n    }\n\n    .family {\n      display: inline-block;\n      border: 1px solid #bfd5e5;\n      background: #f7fbfeaa;\n      border-radius: 30px;\n      padding: 8px 20px;\n      margin-top: 25px;\n      font-size: 13px;\n      color: #3c6480;\n    }\n\n    .sky {\n      position: absolute;\n      pointer-events: none;\n      opacity: .85;\n    }\n\n    .sky.left { left: 3%; top: 43px; width: 200px; }\n    .sky.right { right: 4%; bottom: 30px; width: 190px; }\n\n    .stars {\n      color: var(--gold);\n      font-size: 23px;\n      letter-spacing: 12px;\n      margin-bottom: 15px;\n    }\n\n    .wrap {\n      max-width: 1110px;\n      margin: auto;\n      padding: 35px 24px 60px;\n    }\n\n    .welcome {\n      display: flex;\n      gap: 20px;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 31px;\n    }\n\n    .welcome p {\n      margin: 0;\n      color: var(--muted);\n      max-width: 630px;\n      font-size: 14px;\n    }\n\n    .welcome strong { color: var(--ink); }\n\n    .steps {\n      white-space: nowrap;\n      font-size: 12px;\n      letter-spacing: .025em;\n      color: #52748d;\n    }\n\n    .favorites {\n      margin-bottom: 28px;\n      padding: 24px 27px;\n      border: 1px solid var(--line);\n      border-radius: 18px;\n      background: var(--pale);\n    }\n\n    .favorites h2 {\n      font: normal 25px/1.2 Georgia, serif;\n      margin: 0 0 18px;\n    }\n\n    .favorites-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 20px 28px;\n    }\n\n    .favorites h3 {\n      font-size: 13px;\n      margin: 0 0 10px;\n    }\n\n    .favorites ul {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      list-style: none;\n      padding: 0;\n      margin: 0;\n    }\n\n    .favorites li {\n      background: white;\n      border: 1px solid var(--line);\n      border-radius: 20px;\n      padding: 6px 12px;\n      font-size: 13px;\n    }\n\n    .layout {\n      display: grid;\n      grid-template-columns: minmax(0, 1.03fr) minmax(0, 1fr);\n      gap: 28px;\n      align-items: start;\n    }\n\n    .panel {\n      background: white;\n      border: 1px solid var(--line);\n      border-radius: 22px;\n      overflow: hidden;\n      box-shadow: 0 8px 30px #23496605;\n    }\n\n    .panel-head { padding: 26px 27px 0; }\n\n    .kicker {\n      font-size: 10px;\n      font-weight: 800;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n      color: #7a94a6;\n      margin: 0 0 8px;\n    }\n\n    .panel h2 {\n      font: normal 30px/1.2 Georgia, serif;\n      letter-spacing: -.02em;\n      margin: 0 0 10px;\n    }\n\n    .sub {\n      color: var(--muted);\n      font-size: 13px;\n      margin: 0;\n    }\n\n    .panel-body { padding: 23px 27px 27px; }\n\n    .row {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 16px;\n    }\n\n    .field { margin-bottom: 17px; min-width: 0; }\n\n    label {\n      font-size: 12px;\n      font-weight: 700;\n      display: block;\n      margin-bottom: 7px;\n    }\n\n    label span { color: #768b99; font-weight: 400; }\n\n    .field input,\n    .field select,\n    .field textarea {\n      display: block;\n      width: 100%;\n      border: 1px solid #cbdce8;\n      border-radius: 10px;\n      background: #fcfeff;\n      color: var(--ink);\n      padding: 11px 12px;\n      min-height: 46px;\n      outline: none;\n    }\n\n    .field textarea { resize: vertical; min-height: 88px; }\n\n    input:focus,\n    select:focus,\n    textarea:focus,\n    button:focus-visible,\n    a:focus-visible {\n      outline: 3px solid #a7cde5;\n      outline-offset: 2px;\n    }\n\n    .hint {\n      font-size: 11px;\n      line-height: 1.5;\n      color: var(--muted);\n      margin: 6px 0 0;\n    }\n\n    .primary {\n      width: 100%;\n      background: var(--deep);\n      color: white;\n      border: 0;\n      border-radius: 11px;\n      padding: 13px 20px;\n      font-size: 14px;\n      font-weight: 700;\n    }\n\n    .primary:hover { background: #244e6e; }\n\n    .footnote {\n      text-align: center;\n      font-size: 11px;\n      color: var(--muted);\n      margin: 11px 0 0;\n    }\n\n    .notice {\n      padding: 13px 15px;\n      border-radius: 11px;\n      font-size: 13px;\n      margin: 0 0 18px;\n      white-space: pre-line;\n    }\n\n    .notice.error {\n      background: #fff2ee;\n      color: #904531;\n      border: 1px solid #f0d0c4;\n    }\n\n    .notice.success {\n      background: #edf7f3;\n      color: #28624d;\n      border: 1px solid #c7e6d8;\n    }\n\n    [hidden] { display: none !important; }\n\n    .honeypot {\n      position: absolute;\n      left: -10000px;\n      width: 1px;\n      height: 1px;\n      overflow: hidden;\n    }\n\n    .schedule-tools {\n      display: flex;\n      gap: 10px;\n      align-items: center;\n      justify-content: space-between;\n      margin-bottom: 18px;\n    }\n\n    .count { font-size: 12px; color: var(--muted); }\n\n    .refresh {\n      border: 1px solid var(--line);\n      border-radius: 8px;\n      background: white;\n      padding: 7px 12px;\n      color: var(--deep);\n      font-size: 12px;\n    }\n\n    .empty {\n      border: 1px dashed #c5dbe9;\n      background: var(--pale);\n      border-radius: 15px;\n      text-align: center;\n      padding: 32px 22px;\n      color: var(--muted);\n      font-size: 13px;\n    }\n\n    .empty .symbol {\n      font-size: 31px;\n      color: #88afc8;\n      margin-bottom: 10px;\n    }\n\n    .empty strong {\n      display: block;\n      color: var(--ink);\n      font-size: 15px;\n      margin-bottom: 7px;\n    }\n\n    .day { margin-bottom: 22px; }\n\n    .day h3 {\n      font-size: 12px;\n      font-weight: 750;\n      letter-spacing: .015em;\n      margin: 0 0 10px;\n      color: #46677f;\n    }\n\n    .entry {\n      border: 1px solid var(--line);\n      border-left: 3px solid #a7c9e0;\n      border-radius: 12px;\n      padding: 14px 16px;\n      margin-bottom: 9px;\n      overflow-wrap: anywhere;\n    }\n\n    .entry-top {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 10px;\n      margin-bottom: 6px;\n    }\n\n    .badge {\n      display: inline-block;\n      border-radius: 6px;\n      background: #eaf4fb;\n      padding: 3px 8px;\n      font-size: 10px;\n      font-weight: 750;\n    }\n\n    .entry time { color: var(--muted); font-size: 11px; }\n\n    .entry h4 {\n      font-size: 14px;\n      margin: 2px 0 5px;\n      font-weight: 700;\n    }\n\n    .entry p {\n      font-size: 12px;\n      color: var(--muted);\n      margin: 3px 0;\n    }\n\n    .entry .note {\n      padding-top: 8px;\n      border-top: 1px solid #edf2f5;\n      margin-top: 10px;\n      white-space: pre-wrap;\n    }\n\n    .care {\n      margin-top: 20px;\n      padding: 19px 21px;\n      background: #f2f7fa;\n      border-radius: 15px;\n      border: 1px solid #e4edf3;\n    }\n\n    .care h3 {\n      font: normal 20px Georgia, serif;\n      margin: 0 0 10px;\n    }\n\n    .care p {\n      font-size: 12px;\n      color: var(--muted);\n      margin: 8px 0;\n    }\n\n    .footer {\n      text-align: center;\n      margin-top: 40px;\n      font: italic 18px Georgia, serif;\n      color: #7b97ac;\n    }\n\n    .footer small {\n      display: block;\n      font: 11px system-ui, sans-serif;\n      margin-top: 10px;\n    }\n\n    @media (max-width: 760px) {\n      .topbar { padding: 18px 20px; }\n      .hero { padding: 45px 20px 46px; }\n\n      .sky.left {\n        left: -63px;\n        top: 20px;\n        width: 150px;\n        opacity: .45;\n      }\n\n      .sky.right {\n        right: -70px;\n        width: 155px;\n        opacity: .45;\n      }\n\n      .hero p.lede { font-size: 15px; max-width: 350px; }\n      .wrap { padding: 25px 16px 40px; }\n      .welcome { display: block; }\n      .steps { margin-top: 14px; }\n      .favorites { padding: 21px; }\n      .favorites-grid { grid-template-columns: 1fr; }\n      .layout { grid-template-columns: 1fr; gap: 22px; }\n      .panel-head { padding: 23px 21px 0; }\n      .panel-body { padding: 21px; }\n      .hero h1 { font-size: 54px; }\n    }\n\n    @media (max-width: 360px) {\n      .row { grid-template-columns: 1fr; gap: 0; }\n      .hero h1 { font-size: 46px; }\n      .topbar { font-size: 11px; }\n    }\n\n    @media (prefers-reduced-motion: no-preference) {\n      .primary, .refresh { transition: background .15s ease; }\n    }\n  </style>\n<style>select.demo-select{display:block;width:100%;min-height:48px;padding:12px;border:1px solid #b7c6bf;border-radius:12px;background:#fff;color:#183b37;font:inherit}select.demo-select:focus-visible{outline:3px solid #986119;outline-offset:3px}</style></head>\n\n<body><div style=\"padding:10px 18px;background:#fff3ce;color:#49330c;font:600 14px/1.5 system-ui;text-align:center\" role=\"note\">Interactive portfolio demo · Fictional sample data only. Choose from fictional dropdown options. No personal information can be entered.</div>\n  <header class=\"topbar\">\n    <div class=\"brand\">☁ &nbsp; RAFAEL'S LITTLE VILLAGE</div>\n  </header>\n\n  <section class=\"hero\">\n    <svg class=\"sky left\" viewBox=\"0 0 200 180\" aria-hidden=\"true\">\n      <path\n        d=\"M122 13a51 51 0 1 0 36 80 43 43 0 0 1-36-80\"\n        fill=\"#fffdf6\"\n      />\n      <path\n        d=\"M18 135c-20-28 13-51 36-31 1-37 56-41 65-6 36-8 52 38 17 46H28z\"\n        fill=\"#fff\"\n      />\n      <path\n        d=\"m166 16 3 10 10 3-10 3-3 10-3-10-10-3 10-3z\"\n        fill=\"#bda271\"\n      />\n    </svg>\n\n    <svg class=\"sky right\" viewBox=\"0 0 200 150\" aria-hidden=\"true\">\n      <path\n        d=\"M19 92c-16-28 15-47 35-31 5-35 58-36 66-1 33-10 55 35 20 43H29z\"\n        fill=\"#fff\"\n      />\n      <path\n        d=\"m50 10 4 12 13 4-13 4-4 12-4-12-13-4 13-4zm115 100 3 8 9 3-9 3-3 9-3-9-9-3 9-3z\"\n        fill=\"#bda271\"\n      />\n    </svg>\n\n    <div class=\"stars\" aria-hidden=\"true\">✧ ⋆ ✧</div>\n    <p class=\"eyebrow\">Little boy. Big love.</p>\n    <h1>A little love<br>for <em>Rafael.</em></h1>\n\n    <p class=\"lede\">\n      Let's surround Sample Parent A, Sample Parent B, and their baby boy with\n      full hearts, warm meals, and a little extra care.\n    </p>\n\n    <div class=\"family\">For Sample Parent A, Sample Parent B &amp; baby Rafael</div>\n  </section>\n\n  <main class=\"wrap\">\n    <div class=\"welcome\">\n      <p>\n        <strong>Every little gesture makes a difference.</strong><br>\n        Choose a day to bring a meal, send a gift card, or share\n        something sweet for baby Rafael.\n      </p>\n\n      <div class=\"steps\">\n        01 &nbsp; Pick a day &nbsp; · &nbsp;\n        02 &nbsp; Choose your gift &nbsp; · &nbsp;\n        03 &nbsp; Send love\n      </div>\n    </div>\n\n    <section class=\"favorites\" aria-labelledby=\"favorites-heading\">\n      <h2 id=\"favorites-heading\">A few family favorites</h2>\n      <div class=\"favorites-grid\">\n        <div>\n          <h3>Gift-card ideas</h3>\n          <ul role=\"list\">\n            <li>H-E-B</li>\n            <li>Uber Eats</li>\n            <li>DoorDash</li>\n            <li>Starbucks</li>\n          </ul>\n        </div>\n        <div>\n          <h3>Restaurants they enjoy</h3>\n          <ul role=\"list\">\n            <li>El Tiempo</li>\n            <li>Terry Black’s BBQ</li>\n            <li>Pho Ben</li>\n            <li>Niko Niko</li>\n          </ul>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"layout\">\n      <section class=\"panel\" aria-labelledby=\"signup-heading\">\n        <div class=\"panel-head\">\n          <p class=\"kicker\">A place in their village</p>\n          <h2 id=\"signup-heading\">I'd love to help.</h2>\n          <p class=\"sub\">Add your plans so everyone can coordinate.</p>\n        </div>\n\n        <div class=\"panel-body\">\n          <div\n            id=\"message\"\n            class=\"notice\"\n            role=\"status\"\n            aria-live=\"polite\"\n            tabindex=\"-1\"\n            hidden\n          ></div>\n\n          <form id=\"signup-form\">\n            <div class=\"field\">\n              <label for=\"name\">Your name</label>\n              <select class=\"demo-select\" id=\"name\" name=\"name\" required aria-label=\"Fictional name\"><option value=\"Alex Example\">Alex Example</option><option value=\"Morgan Sample\">Morgan Sample</option><option value=\"Taylor Demo\">Taylor Demo</option><option value=\"Casey Placeholder\">Casey Placeholder</option><option value=\"Holly Snow\">Holly Snow</option><option value=\"Noel Snow\">Noel Snow</option><option value=\"Nick Frost\">Nick Frost</option><option value=\"Jolly Evergreen\">Jolly Evergreen</option><option value=\"Holly Maple\">Holly Maple</option><option value=\"Oliver Acorn\">Oliver Acorn</option><option value=\"Autumn Fields\">Autumn Fields</option></select>\n            </div>\n\n            <div class=\"row\">\n              <div class=\"field\">\n                <label for=\"date\">Date</label>\n                <select class=\"demo-select\" id=\"date\" name=\"date\" required aria-label=\"Sample date\">__DEMO_DATE_OPTIONS__</select>\n              </div>\n\n              <div class=\"field\">\n                <label for=\"type\">I'd like to bring…</label>\n                <select id=\"type\" name=\"type\" required>\n                  <option value=\"\">Choose an option</option>\n                  <option>Breakfast</option>\n                  <option>Lunch</option>\n                  <option>Dinner</option>\n                  <option>Snacks</option>\n                  <option>Gift Card</option>\n                  <option>Baby Gift</option>\n                  <option>Other</option>\n                </select>\n              </div>\n            </div>\n\n            <p\n              id=\"slot-hint\"\n              class=\"hint\"\n              style=\"margin:-8px 0 17px\"\n              aria-live=\"polite\"\n            >\n              Breakfast, lunch, and dinner each have one signup per day.\n            </p>\n\n            <div class=\"field\">\n              <label for=\"item\">What are you bringing?</label>\n              <select class=\"demo-select\" id=\"item\" name=\"item\" required aria-label=\"Sample item\"><option value=\"Vegetable lasagna\">Vegetable lasagna</option><option value=\"Soup and salad\">Soup and salad</option><option value=\"Fruit basket\">Fruit basket</option><option value=\"Sample pizza\">Sample pizza</option><option value=\"Sample gift card\">Sample gift card</option><option value=\"Sample baby blanket\">Sample baby blanket</option></select>\n            </div>\n\n            <div class=\"row\">\n              <div class=\"field\">\n                <label for=\"time\">\n                  Delivery time <span>· optional</span>\n                </label>\n                <select class=\"demo-select\" id=\"time\" name=\"time\" aria-label=\"Sample delivery time\"><option value=\"\">None / not selected</option><option value=\"09:00\">09:00</option><option value=\"12:00\">12:00</option><option value=\"15:00\">15:00</option><option value=\"17:30\">17:30</option><option value=\"18:00\">18:00</option></select>\n                <p class=\"hint\">Times are Central Time.</p>\n              </div>\n\n              <div class=\"field\" id=\"amount-field\" hidden>\n                <label for=\"amount\">\n                  Gift-card amount <span>· optional</span>\n                </label>\n                <select class=\"demo-select\" id=\"amount\" name=\"amount\" aria-label=\"Sample gift-card amount\"><option value=\"\">None / not selected</option><option value=\"25\">25</option><option value=\"50\">50</option><option value=\"100\">100</option></select>\n                <p class=\"hint\">Visible only to the organizers.</p>\n              </div>\n            </div>\n\n            <div class=\"field\">\n              <label for=\"note\">\n                A little note <span>· optional, public</span>\n              </label>\n              <select class=\"demo-select\" id=\"note\" name=\"note\" aria-label=\"Sample note\"><option value=\"\">None / not selected</option><option value=\"Fictional sample signup\">Fictional sample signup</option><option value=\"Enjoy the sample meal!\">Enjoy the sample meal!</option><option value=\"Demo delivery only.\">Demo delivery only.</option></select>\n            </div>\n\n            <div class=\"field\">\n              <label for=\"contact\">\n                Contact details <span>· disabled in this demo</span>\n              </label>\n              <select class=\"demo-select\" id=\"contact\" name=\"contact\" aria-label=\"Contact details not collected\"><option value=\"\">No contact details collected</option></select>\n              <p class=\"hint\">\n                No contact information is collected in this demo.\n              </p>\n            </div>\n\n            \n\n            <button\n              id=\"submit\"\n              class=\"primary\"\n              type=\"submit\"\n              disabled\n            >\n              Loading schedule…\n            </button>\n\n            <p class=\"footnote\">\n              Your name and signup details appear on the schedule.<br>\n              This is a commitment only; no payment is collected.\n            </p>\n          </form>\n        </div>\n      </section>\n\n      <div>\n        <section\n          class=\"panel\"\n          id=\"schedule\"\n          aria-labelledby=\"schedule-heading\"\n        >\n          <div class=\"panel-head\">\n            <p class=\"kicker\">Love on the calendar</p>\n            <h2 id=\"schedule-heading\">What's on the way</h2>\n            <p class=\"sub\">\n              Upcoming meals, thoughtful gifts, and helping hands.\n            </p>\n          </div>\n\n          <div class=\"panel-body\">\n            <div class=\"schedule-tools\">\n              <span id=\"count\" class=\"count\" aria-live=\"polite\">\n                Loading…\n              </span>\n              <button id=\"refresh\" class=\"refresh\" type=\"button\">\n                ↻ Refresh\n              </button>\n            </div>\n\n            <div\n              id=\"schedule-message\"\n              class=\"notice error\"\n              role=\"status\"\n              hidden\n            ></div>\n\n            <div id=\"entries\" aria-live=\"polite\">\n              <div class=\"empty\">Gathering the latest signups…</div>\n            </div>\n          </div>\n        </section>\n\n        <aside class=\"care\">\n          <h3>A little care goes a long way.</h3>\n          <p>\n            Check with the family about allergies and food needs\n            before preparing a meal.\n          </p>\n          <p>\n            Coordinate the delivery address and timing directly.\n            Give the new family space to rest, and arrange visits\n            in advance.\n          </p>\n          <p>\n            Need to change your signup? Contact the organizer so\n            they can update the schedule.\n          </p>\n        </aside>\n      </div>\n    </div>\n\n    <footer class=\"footer\">\n      Tiny hands. A whole village of love.\n      <small>\n        Made with love for Sample Parent A, Sample Parent B &amp; Rafael &nbsp; ✧\n      </small>\n    </footer>\n  </main>\n\n  <script>\n    'use strict';\n\n    const $ = id => document.getElementById(id);\n\n    let signups = [];\n    let ready = false;\n    let busy = false;\n    let requestId = '';\n    let requestSnapshot = '';\n    let loading = false;\n\n    const meals = ['Breakfast', 'Lunch', 'Dinner'];\n\n    function rpc(method, payload) {\n      return new Promise((resolve, reject) => {\n        if (!(window.google && google.script && google.script.run)) {\n          reject(new Error(\n            'Open the deployed web app to load the schedule and sign up.'\n          ));\n          return;\n        }\n\n        const runner = google.script.run\n          .withSuccessHandler(resolve)\n          .withFailureHandler(reject);\n\n        if (method === 'getPageData') {\n          runner.getPageData();\n        } else {\n          runner.submitSignup(payload);\n        }\n      });\n    }\n\n    function showMessage(text, kind) {\n      const el = $('message');\n      el.textContent = text;\n      el.className = 'notice ' + kind;\n      el.hidden = false;\n      el.focus();\n    }\n\n    function conflict() {\n      return meals.includes($('type').value) &&\n        signups.some(r =>\n          r.date === $('date').value &&\n          r.type === $('type').value\n        );\n    }\n\n    function updateForm() {\n      const gift = $('type').value === 'Gift Card';\n\n      $('amount-field').hidden = !gift;\n      $('amount').disabled = !gift;\n\n      const taken = conflict();\n\n      $('slot-hint').textContent = taken\n        ? 'That meal is already covered. Please choose another date or type.'\n        : 'Breakfast, lunch, and dinner each have one signup per day.';\n\n      $('submit').disabled = !ready || busy || taken;\n\n      $('submit').textContent = busy\n        ? 'Saving your signup…'\n        : !ready\n          ? 'Schedule unavailable — tap Refresh'\n          : taken\n            ? 'Please choose an open meal slot'\n            : 'Count me in  ♡';\n    }\n\n    function dateLabel(value) {\n      const p = value.split('-').map(Number);\n\n      return new Intl.DateTimeFormat('en-US', {\n        weekday: 'long',\n        month: 'long',\n        day: 'numeric',\n        year: 'numeric'\n      }).format(new Date(p[0], p[1] - 1, p[2], 12));\n    }\n\n    function timeLabel(value) {\n      if (!value) return 'Time to be arranged';\n\n      const p = value.split(':').map(Number);\n\n      return (p[0] % 12 || 12) + ':' +\n        String(p[1]).padStart(2, '0') +\n        (p[0] < 12 ? ' AM' : ' PM') + ' CT';\n    }\n\n    function node(tag, cls, text) {\n      const el = document.createElement(tag);\n      if (cls) el.className = cls;\n      if (text !== undefined) el.textContent = text;\n      return el;\n    }\n\n    function renderSchedule() {\n      const root = $('entries');\n      root.replaceChildren();\n\n      $('count').textContent = signups.length +\n        (signups.length === 1\n          ? ' upcoming signup'\n          : ' upcoming signups');\n\n      if (!signups.length) {\n        const empty = node('div', 'empty');\n\n        empty.append(\n          node('div', 'symbol', '☁'),\n          node('strong', '', 'Be the first to send a little love.'),\n          node(\n            'span',\n            '',\n            'The calendar is open. Pick a day and help welcome baby Rafael.'\n          )\n        );\n\n        root.append(empty);\n        return;\n      }\n\n      let lastDate = '';\n      let group;\n\n      signups.forEach(r => {\n        if (r.date !== lastDate) {\n          group = node('section', 'day');\n          group.append(node('h3', '', dateLabel(r.date)));\n          root.append(group);\n          lastDate = r.date;\n        }\n\n        const card = node('article', 'entry');\n        const top = node('div', 'entry-top');\n\n        top.append(\n          node('span', 'badge', r.type),\n          node('time', '', timeLabel(r.time))\n        );\n\n        card.append(\n          top,\n          node('h4', '', r.item),\n          node('p', '', 'From ' + r.name)\n        );\n\n        if (r.note) {\n          card.append(node('p', 'note', r.note));\n        }\n\n        group.append(card);\n      });\n    }\n\n    async function loadSchedule() {\n      if (loading) return;\n\n      loading = true;\n      $('refresh').disabled = true;\n\n      try {\n        const data = await rpc('getPageData');\n\n        signups = data.signups;\n        $('date').min = data.today;\n\n        const selected = $('type').value;\n\n        $('type').replaceChildren(\n          new Option('Choose an option', '')\n        );\n\n        data.types.forEach(t => {\n          $('type').add(new Option(t, t));\n        });\n\n        $('type').value = selected;\n\n        ready = true;\n        $('schedule-message').hidden = true;\n        renderSchedule();\n      } catch (err) {\n        ready = false;\n\n        $('schedule-message').textContent =\n          'Could not refresh the schedule. ' +\n          (err.message || 'Please try again.');\n\n        $('schedule-message').hidden = false;\n\n        if (!signups.length) {\n          $('count').textContent = 'Schedule unavailable';\n          $('entries').replaceChildren();\n        } else {\n          $('count').textContent = 'Showing the last loaded schedule';\n        }\n      } finally {\n        loading = false;\n        $('refresh').disabled = false;\n        updateForm();\n      }\n    }\n\n    function newId() {\n      return window.crypto && crypto.randomUUID\n        ? crypto.randomUUID()\n        : 'signup_' +\n          Date.now().toString(36) + '_' +\n          Math.random().toString(36).slice(2) +\n          Math.random().toString(36).slice(2);\n    }\n\n    $('type').addEventListener('change', updateForm);\n    $('date').addEventListener('change', updateForm);\n    $('refresh').addEventListener('click', loadSchedule);\n\n    $('signup-form').addEventListener('submit', async event => {\n      event.preventDefault();\n\n      if (\n        busy ||\n        !ready ||\n        conflict() ||\n        !event.target.reportValidity()\n      ) {\n        return;\n      }\n\n      const payload = Object.fromEntries(\n        new FormData(event.target).entries()\n      );\n\n      if (payload.type !== 'Gift Card') {\n        payload.amount = '';\n      }\n\n      const snapshot = JSON.stringify(payload);\n\n      if (!requestId || requestSnapshot !== snapshot) {\n        requestId = newId();\n        requestSnapshot = snapshot;\n      }\n\n      payload.requestId = requestId;\n\n      busy = true;\n      updateForm();\n      $('message').hidden = true;\n\n      const controls = [\n        ...event.target.querySelectorAll('input,select,textarea')\n      ];\n\n      controls.forEach(c => c.disabled = true);\n\n      try {\n        const result = await rpc('submitSignup', payload);\n\n        if (!result || !result.ok) {\n          throw new Error(\n            'The signup could not be confirmed. Please try again.'\n          );\n        }\n\n        event.target.reset();\n        requestId = '';\n        requestSnapshot = '';\n\n        showMessage(\n          'You’re on the calendar! Thank you for showing Sample Parent A, ' +\n          'Sample Parent B, and baby Rafael some love. Please coordinate ' +\n          'delivery directly with the family.',\n          'success'\n        );\n\n        await loadSchedule();\n      } catch (err) {\n        showMessage(\n          err.message ||\n          'Unable to confirm your signup. Please retry; an unchanged ' +\n          'retry will not create a duplicate.',\n          'error'\n        );\n\n        await loadSchedule();\n      } finally {\n        controls.forEach(c => c.disabled = false);\n        busy = false;\n        updateForm();\n      }\n    });\n\n    loadSchedule();\n  </script>\n</body>\n</html>"};
function doGet(e){const slug=String(e&&e.parameter&&e.parameter.demo||"christmas");if(!Object.prototype.hasOwnProperty.call(DEMO_PAGES,slug))return HtmlService.createHtmlOutput("Demo not found");return HtmlService.createHtmlOutput(demoPage_(slug)).setTitle({christmas:"Christmas Demo",thanksgiving:"Thanksgiving Demo",decker:"Baby Decker — Fictional Demo",rafa:"Baby Rafa — Fictional Demo"}[slug]).addMetaTag("viewport","width=device-width, initial-scale=1");}
